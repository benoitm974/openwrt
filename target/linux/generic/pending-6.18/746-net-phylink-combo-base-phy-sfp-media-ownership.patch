+static struct gpio_desc *phylink_combo_medium_gpio(struct phylink *pl)
+{
+	struct gpio_desc *desc;
+
+	if (pl->combo_medium_gpio)
+		return pl->combo_medium_gpio;
+	if (!pl->combo_fwnode)
+		return NULL;
+
+	desc = fwnode_gpiod_get_index(pl->combo_fwnode, "combo-medium",
+				      0, GPIOD_OUT_LOW, "combo-medium");
+	if (IS_ERR(desc))
+		return NULL;
+
+	pl->combo_medium_gpio = desc;
+	return desc;
+}
