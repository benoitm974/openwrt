+/*
+ * Support combo ports that have both a fixed base PHY (phy-handle) and an
+ * SFP cage on the same MAC: media ownership is transferred to the SFP
+ * module when a module is detected and returned to the base PHY when the
+ * module goes away.  The sfp callbacks run from work without rtnl held,
+ * like the existing phylink sfp callbacks.
+ */
+static int phylink_sfp_detach_base_phy(struct phylink *pl)
+{
+	struct phy_device *phy;
+
+	if (pl->sfp_media_owner || !pl->phydev)
+		return 0;
+
+	if (WARN_ON(!pl->sfp_base_phy_active || !pl->sfp_base_phy))
+		return -EINVAL;
+
+	phylink_info(pl, "combo: detaching base PHY, SFP takes over\n");
+
+	if (phylink_combo_medium_gpio(pl))
+		gpiod_set_value_cansleep(pl->combo_medium_gpio, 1);
+
+	pl->sfp_base_interface = pl->link_interface;
+	pl->sfp_base_port = pl->link_port;
+
+	mutex_lock(&pl->phydev_mutex);
+	phy = pl->phydev;
+	mutex_lock(&phy->lock);
+	mutex_lock(&pl->state_mutex);
+	pl->phydev = NULL;
+	pl->phy_enable_tx_lpi = false;
+	pl->mac_tx_clk_stop = false;
+	mutex_unlock(&pl->state_mutex);
+	mutex_unlock(&phy->lock);
+	mutex_unlock(&pl->phydev_mutex);
+
+	flush_work(&pl->resolve);
+	phy_disconnect(phy);
+
+	/* Force a link-down event: the base PHY state is stale once detached
+	 * and would otherwise be reported until the SFP interface is set.
+	 */
+	pl->link_failed = true;
+
+	pl->sfp_base_phy_active = false;
+	pl->sfp_media_owner = true;
+
+	return 0;
+}
+
+static void phylink_sfp_restore_base_phy(struct phylink *pl)
+{
+	struct phy_device *phy;
+	int ret;
+
+	if (!pl->sfp_media_owner)
+		return;
+
+	pl->sfp_media_owner = false;
+
+	/* detach the SFP module PHY first, if it is still attached */
+	phy = pl->phydev;
+	if (phy && phy->attached_dev) {
+		mutex_lock(&pl->phydev_mutex);
+		mutex_lock(&phy->lock);
+		mutex_lock(&pl->state_mutex);
+		pl->phydev = NULL;
+		pl->phy_enable_tx_lpi = false;
+		pl->mac_tx_clk_stop = false;
+		mutex_unlock(&pl->state_mutex);
+		mutex_unlock(&phy->lock);
+		mutex_unlock(&pl->phydev_mutex);
+
+		flush_work(&pl->resolve);
+		phy_disconnect(phy);
+	} else if (phy) {
+		mutex_lock(&pl->phydev_mutex);
+		pl->phydev = NULL;
+		mutex_unlock(&pl->phydev_mutex);
+	}
+
+	phy = pl->sfp_base_phy;
+	if (!phy) {
+		phylink_err(pl, "combo: no base PHY to restore\n");
+		phylink_enable_and_run_resolve(pl, PHYLINK_DISABLE_LINK);
+		return;
+	}
+
+	phylink_info(pl, "combo: restoring base PHY\n");
+
+	if (phylink_combo_medium_gpio(pl))
+		gpiod_set_value_cansleep(pl->combo_medium_gpio, 0);
+
+	pl->link_interface = pl->sfp_base_interface;
+	pl->link_config.interface = pl->sfp_base_interface;
+	pl->req_link_an_mode = pl->cfg_link_an_mode;
+	pl->link_port = pl->sfp_base_port;
+
+	ret = phy_attach_direct(pl->netdev, phy, 0, pl->link_interface);
+	if (ret) {
+		phylink_err(pl, "combo: base PHY reattach failed: %pe\n",
+			    ERR_PTR(ret));
+		phylink_enable_and_run_resolve(pl, PHYLINK_DISABLE_LINK);
+		return;
+	}
+
+	ret = phylink_bringup_phy(pl, phy, pl->link_interface);
+	if (ret) {
+		phylink_err(pl, "combo: base PHY bringup failed: %pe\n",
+			    ERR_PTR(ret));
+		phy_detach(phy);
+		phylink_enable_and_run_resolve(pl, PHYLINK_DISABLE_LINK);
+		return;
+	}
+
+	pl->sfp_base_phy_active = true;
+
+	if (!test_bit(PHYLINK_DISABLE_STOPPED, &pl->phylink_disable_state))
+		phy_start(phy);
+
+	/* Replay the base interface synchronously; writing link_config before
+	 * the PCS reconfig would otherwise suppress the interface-change major
+	 * config (and a later forced replay races the link-down state).
+	 */
+	phylink_mac_initial_config(pl, false);
+
+	phylink_enable_and_run_resolve(pl, PHYLINK_DISABLE_LINK);
+	phylink_info(pl, "combo: base PHY restored\n");
+}
