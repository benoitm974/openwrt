 	u8 ip_proto;
@@ -1311,6 +1495,19 @@
 			vlan_push_seen = true;
 			vlan_push_vid = act->vlan.vid;
 			break;
+		case FLOW_ACTION_PPPOE_PUSH:
+			/* The flowtable resolved a PPPoE upper down to the
+			 * plain EDMA device and hands the session over as
+			 * this action; the encapsulation itself is carried
+			 * by a dedicated egress L3 interface clone below.
+			 */
+			if (pppoe_seen)
+				return ppe_offload_decline("second pppoe header unsupported");
+			if (!act->pppoe.sid)
+				return ppe_offload_decline("pppoe session id 0");
+			pppoe_seen = true;
+			pppoe_sid = act->pppoe.sid;
+			break;
 		case FLOW_ACTION_VLAN_POP:
 			/* The parser has already classified past the ingress
 			 * tag and routed egress rebuilds L2 from the nexthop, so
@@ -1443,7 +1640,9 @@
 	} else if (new_src != match_src && new_dst == match_dst && l4.dest == match_dport) {
 		snat = true;
 	} else if (new_dst != match_dst && new_src == match_src && l4.source == match_sport) {
-		if (!dst_on_ingress)
+		if (!dst_on_ingress &&
+		    !ppe_offload_pppoe_reply_on_ingress(priv, match_dst, ingress_l3_if,
+						       dev_net(netdev)))
 			return ppe_offload_decline("dnat of %pI4, not an address of ingress %d",
 						    &match_dst, meta.key->ingress_ifindex);
 		snat = false;
@@ -1533,6 +1732,25 @@
 	 */
 	nexthop.port = port_priv->ppe_port->port_id;
 	nexthop.post_l3_if = port_priv->l3_if_index;
+	if (pppoe_seen) {
+		struct net_device *ppp_dev = NULL;
+
+		/* Swap in the session's clone before the nexthop is pooled:
+		 * post_l3_if is part of the pool key, so session and
+		 * non-session nexthops never merge. The SNAT shape's
+		 * translated source is the session's own address, which
+		 * names its PPP netdevice for the reply-direction check.
+		 */
+		if (!ipv6 && new_src != match_src)
+			ppp_dev = __ip_dev_find(dev_net(netdev), new_src, false);
+		ret = ppe_offload_pppoe_eg_get_and_ref(priv, port_priv->l3_if_index,
+						       pppoe_sid, ppp_dev, &pppoe_index);
+		if (ret) {
+			stage = "pppoe_eg";
+			goto deref_pub_ip;
+		}
+		nexthop.post_l3_if = pppoe_index;
+	}
 	memcpy(nexthop.dmac, eth.bytes, ETH_ALEN);
 	if (snat)
 		nexthop.pub_addr_index = pub_ip_index;
@@ -1547,7 +1765,7 @@
 					    &nexthop_index);
 	if (ret) {
 		stage = "nexthop";
-		goto deref_pub_ip;
+		goto deref_pppoe;
 	}
 
 	/* Host entry for the original (pre-NAT) source address, for both
@@ -1675,6 +1893,8 @@
 	entry->host_index = host_index;
 	entry->nexthop_index = nexthop_index;
 	entry->pub_ip_index = pub_ip_index;
+	entry->pppoe_eg_index = pppoe_index;
+	entry->pppoe_eg_valid = pppoe_seen;
 	entry->pub_ip_valid = pub_ip;
 	entry->flow_valid = true;
 
@@ -1729,6 +1949,9 @@
 	ppe_host_pool_deref(priv->ppe_dev, &priv->host_pool, host_index);
 deref_nexthop:
 	ppe_nexthop_pool_deref(priv->ppe_dev, &priv->nexthop_pool, nexthop_index);
+deref_pppoe:
+	if (pppoe_seen)
+		ppe_offload_pppoe_eg_deref(priv, pppoe_index);
 deref_pub_ip:
 	if (pub_ip)
 		ppe_pub_ip_pool_deref(priv->ppe_dev, &priv->pub_ip_pool, pub_ip_index);
@@ -1794,6 +2017,8 @@
 		ppe_flow_entry_del(priv->ppe_dev, entry->flow_index);
 	ppe_host_pool_deref(priv->ppe_dev, &priv->host_pool, entry->host_index);
 	ppe_nexthop_pool_deref(priv->ppe_dev, &priv->nexthop_pool, entry->nexthop_index);
+	if (entry->pppoe_eg_valid)
+		ppe_offload_pppoe_eg_deref(priv, entry->pppoe_eg_index);
 	if (entry->pub_ip_valid)
 		ppe_pub_ip_pool_deref(priv->ppe_dev, &priv->pub_ip_pool, entry->pub_ip_index);
 
@@ -1882,6 +2107,8 @@
 	ppe_offload_flow_disown(priv, entry);
 	ppe_host_pool_deref(priv->ppe_dev, &priv->host_pool, entry->host_index);
 	ppe_nexthop_pool_deref(priv->ppe_dev, &priv->nexthop_pool, entry->nexthop_index);
+	if (entry->pppoe_eg_valid)
+		ppe_offload_pppoe_eg_deref(priv, entry->pppoe_eg_index);
 	if (entry->pub_ip_valid)
 		ppe_pub_ip_pool_deref(priv->ppe_dev, &priv->pub_ip_pool, entry->pub_ip_index);
 	kfree(entry);
@@ -2933,7 +3160,7 @@
