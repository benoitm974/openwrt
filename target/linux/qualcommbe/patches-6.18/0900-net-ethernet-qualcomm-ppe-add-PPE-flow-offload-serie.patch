+
+/**
+ * enum ppe_l3_if_action - What hardware does with a frame that fails a check.
+ * @PPE_L3_IF_ACTION_FORWARD: Forward it anyway.
+ * @PPE_L3_IF_ACTION_DROP: Drop it.
+ * @PPE_L3_IF_ACTION_COPY_TO_CPU: Forward it and copy it to the CPU.
+ * @PPE_L3_IF_ACTION_REDIRECT_TO_CPU: Send it to the CPU instead.
+ */
+enum ppe_l3_if_action {
+	PPE_L3_IF_ACTION_FORWARD = 0,
+	PPE_L3_IF_ACTION_DROP,
+	PPE_L3_IF_ACTION_COPY_TO_CPU,
+	PPE_L3_IF_ACTION_REDIRECT_TO_CPU,
+};
+
+/**
+ * struct ppe_l3_if_in_entry - PPE ingress L3 interface table entry.
+ * @mru: Maximum receive unit enforced on this L3 interface, in bytes.
+ * @mtu: Maximum transmit unit enforced on this L3 interface, in bytes.
+ * @mru_ipv6: As @mru, for IPv6 packets.
+ * @mtu_ipv6: As @mtu, for IPv6 packets.
+ * @ttl_dec_bypass: Whether to skip decrementing TTL / hop limit for
+ * traffic routed through this L3 interface.
+ * @ipv4_uc_route_en: Whether IPv4 unicast routing is enabled.
+ * @ipv6_uc_route_en: Whether IPv6 unicast routing is enabled.
+ * @icmp_trigger_en: Whether to redirect to the CPU packets that need
+ * an ICMP error generated (e.g. TTL exceeded) on this L3 interface.
+ * @ttl_exceed_cmd: Forwarding command applied to packets whose TTL /
+ * hop limit has been exceeded.
+ * @ttl_exceed_de_acce: Whether to de-accelerate (stop hardware
+ * offloading) a flow when its TTL / hop limit is exceeded.
+ * @mac_bitmap: Bitmap of MY-MAC table entries this L3 interface
+ * accepts as a valid destination MAC.
+ * @pppoe_en: Whether this L3 interface expects PPPoE encapsulation on
+ * ingress.
+ */
+struct ppe_l3_if_in_entry {
+	u16 mru;
+	u16 mtu;
+	u16 mru_ipv6;
+	u16 mtu_ipv6;
+	bool ttl_dec_bypass;
+	bool ipv4_uc_route_en;
+	bool ipv6_uc_route_en;
+	bool icmp_trigger_en;
+	u8 ttl_exceed_cmd;
+	bool ttl_exceed_de_acce;
+	u8 mac_bitmap;
+	bool pppoe_en;
+};
+
+/**
+ * struct ppe_l3_if_eg_entry - PPE egress L3 interface table entry.
+ * @mac_addr: Source MAC address this L3 interface rewrites routed
+ * packets to use on egress.
+ * @session_id: PPPoE session ID applied on egress, when @pppoe_en.
+ * @pppoe_en: Whether to add a PPPoE encapsulation on egress.
+ */
+struct ppe_l3_if_eg_entry {
+	u8 mac_addr[ETH_ALEN];
+	u16 session_id;
+	bool pppoe_en;
+};
+
+int ppe_my_mac_entry_set(struct ppe_device *ppe_dev, u32 index,
+			  const u8 *mac_addr, bool valid);
+int ppe_l3_if_port_bind(struct ppe_device *ppe_dev, u32 port_id,
+			 u32 l3_if_index, bool valid);
+int ppe_l3_if_in_entry_set(struct ppe_device *ppe_dev, u32 index,
+			    const struct ppe_l3_if_in_entry *entry);
+int ppe_l3_if_in_entry_get(struct ppe_device *ppe_dev, u32 index,
+			    struct ppe_l3_if_in_entry *entry);
+int ppe_l3_if_eg_entry_set(struct ppe_device *ppe_dev, u32 index,
+			    const struct ppe_l3_if_eg_entry *entry);
