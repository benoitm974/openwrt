diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_nexthop_pool.c b/drivers/net/ethernet/qualcomm/ppe/ppe_nexthop_pool.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_nexthop_pool.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_nexthop_pool.c	2026-09-30 08:15:32.920000471 +0000
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* Refcounted, deduplicating allocator on top of the nexthop table
+ * primitive (ppe_nexthop.c). See ppe_nexthop_pool.h for why this
+ * needs its own software dedup, unlike the host table pool.
+ */
+
+#include <linux/errno.h>
+#include <linux/list.h>
+#include <linux/refcount.h>
+#include <linux/string.h>
+
+#include "ppe.h"
+#include "ppe_nexthop.h"
+#include "ppe_nexthop_pool.h"
+
+static bool ppe_nexthop_entry_equal(const struct ppe_nexthop_entry *a,
+				     const struct ppe_nexthop_entry *b)
+{
+	if (a->port_valid != b->port_valid)
+		return false;
+	if (a->port_valid ? a->port != b->port : a->vsi != b->vsi)
+		return false;
+
+	return a->post_l3_if == b->post_l3_if &&
+	       a->ip_to_me == b->ip_to_me &&
+	       a->stag_fmt == b->stag_fmt &&
+	       a->svid == b->svid &&
+	       a->ctag_fmt == b->ctag_fmt &&
+	       a->cvid == b->cvid &&
+	       a->pub_addr_index == b->pub_addr_index &&
+	       a->dnat_ip == b->dnat_ip &&
+	       !memcmp(a->dmac, b->dmac, ETH_ALEN);
+}
+
+/**
+ * ppe_nexthop_pool_init() - Initialize a nexthop table pool.
+ * @pool: The pool to initialize.
+ */
+void ppe_nexthop_pool_init(struct ppe_nexthop_pool *pool)
+{
+	unsigned int i;
+
+	INIT_LIST_HEAD(&pool->free);
+	INIT_LIST_HEAD(&pool->active);
+	mutex_init(&pool->lock);
+
+	for (i = 0; i < PPE_IN_NEXTHOP_TBL_ENTRIES; i++) {
+		pool->entry[i].index = i;
+		pool->entry[i].active = false;
+		list_add_tail(&pool->entry[i].list, &pool->free);
+	}
+}
+
+/**
+ * ppe_nexthop_pool_destroy() - Tear down a nexthop table pool.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to tear down.
+ *
+ * Clears every hardware entry the pool is still tracking. Callers are
+ * expected to have already stopped issuing get/deref calls against
+ * this pool.
+ */
+void ppe_nexthop_pool_destroy(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool)
+{
+	struct ppe_nexthop_pool_entry *e, *tmp;
+	struct ppe_nexthop_entry zero = {};
+
+	list_for_each_entry_safe(e, tmp, &pool->active, list)
+		ppe_nexthop_entry_set(ppe_dev, e->index, &zero);
+}
+
+/**
+ * ppe_nexthop_pool_get_and_ref() - Add a nexthop entry, or ref a matching one.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to allocate from.
+ * @key: The nexthop entry to write, or match against an already-active one.
+ * @index: On success, the entry's hardware index (new or reused).
+ *
+ * Return: 0 on success, a negative error code on failure (-ENOSPC if
+ * the table is full).
+ */
+int ppe_nexthop_pool_get_and_ref(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool,
+				  const struct ppe_nexthop_entry *key, u32 *index)
+{
+	struct ppe_nexthop_pool_entry *e;
+	int ret;
+
+	mutex_lock(&pool->lock);
+
+	list_for_each_entry(e, &pool->active, list) {
+		if (ppe_nexthop_entry_equal(&e->key, key)) {
+			refcount_inc(&e->ref);
+			mutex_unlock(&pool->lock);
+			*index = e->index;
+			return 0;
+		}
+	}
+
+	e = list_first_entry_or_null(&pool->free, struct ppe_nexthop_pool_entry, list);
+	if (!e) {
+		mutex_unlock(&pool->lock);
+		return -ENOSPC;
+	}
+
+	ret = ppe_nexthop_entry_set(ppe_dev, e->index, key);
+	if (ret) {
+		mutex_unlock(&pool->lock);
+		return ret;
+	}
+
+	e->key = *key;
+	e->active = true;
+	refcount_set(&e->ref, 1);
+	list_move_tail(&e->list, &pool->active);
+
+	mutex_unlock(&pool->lock);
+	*index = e->index;
+
+	return 0;
+}
+
+/**
+ * ppe_nexthop_pool_deref() - Drop a reference on a pooled nexthop entry.
+ * @ppe_dev: PPE device.
+ * @pool: The pool @index was allocated from.
+ * @index: The entry index, as returned by ppe_nexthop_pool_get_and_ref().
+ *
+ * Clears the underlying hardware entry once its last reference is
+ * dropped.
+ */
+void ppe_nexthop_pool_deref(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool, u32 index)
+{
+	struct ppe_nexthop_entry zero = {};
+	struct ppe_nexthop_pool_entry *e;
+
+	if (index >= PPE_IN_NEXTHOP_TBL_ENTRIES)
+		return;
+
+	mutex_lock(&pool->lock);
+
+	e = &pool->entry[index];
+	if (!e->active) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	if (!refcount_dec_and_test(&e->ref)) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	e->active = false;
+	memset(&e->key, 0, sizeof(e->key));
+	list_move_tail(&e->list, &pool->free);
+
+	mutex_unlock(&pool->lock);
+
+	ppe_nexthop_entry_set(ppe_dev, index, &zero);
+}
