+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __PPE_NEXTHOP_H__
+#define __PPE_NEXTHOP_H__
+
+#include <linux/if_ether.h>
+#include <linux/types.h>
+
+#include "ppe.h"
+
+/**
+ * struct ppe_nexthop_entry - PPE nexthop table entry.
+ * @port_valid: True if @port is a physical/virtual port index; false if
+ * @vsi is a VSI (bridge domain) index instead. The two share the same
+ * hardware field and are mutually exclusive.
+ * @port: Egress port index, when @port_valid.
+ * @vsi: Egress VSI index, when !@port_valid.
+ * @post_l3_if: L3 interface index applied after this nexthop.
+ * @ip_to_me: True if traffic hitting this nexthop terminates locally.
+ * @stag_fmt: Whether to insert/rewrite an S-VLAN tag on egress.
+ * @svid: S-VLAN ID, when @stag_fmt.
+ * @ctag_fmt: Whether to insert/rewrite a C-VLAN tag on egress.
+ * @cvid: C-VLAN ID, when @ctag_fmt.
+ * @pub_addr_index: Index into the public-IP-address table to use for
+ * SNAT, when this nexthop is used by an SNAT flow. Unused otherwise.
+ * @dmac: Destination MAC address to rewrite the packet to.
+ * @dnat_ip: Destination IPv4 address to rewrite to, for a DNAT nexthop.
+ * Unused otherwise.
+ */
+struct ppe_nexthop_entry {
+	bool port_valid;
+	u16 port;
+	u16 vsi;
+	u16 post_l3_if;
+	bool ip_to_me;
+	bool stag_fmt;
+	u16 svid;
+	bool ctag_fmt;
+	u16 cvid;
+	u8 pub_addr_index;
+	u8 dmac[ETH_ALEN];
+	__be32 dnat_ip;
+};
+
+int ppe_nexthop_entry_set(struct ppe_device *ppe_dev, u32 index,
+			   const struct ppe_nexthop_entry *entry);
+int ppe_nexthop_entry_get(struct ppe_device *ppe_dev, u32 index,
+			   struct ppe_nexthop_entry *entry);
+
+#endif
