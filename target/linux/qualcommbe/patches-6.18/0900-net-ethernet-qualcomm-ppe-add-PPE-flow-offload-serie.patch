+/* The ingress parser follows Ethernet framing plus at most two VLAN tags
+ * whose TPIDs match the VLAN_TPID registers; anything else in front of L3
+ * ends classification, and with it PPE flow lookup for that frame. The
+ * Realtek rtl8_4 DSA tag is 8 bytes at exactly that spot -- and so is a
+ * QinQ pair. The RTL8372N emits it as 0x8899 | 0x0400 | 0x0000 | <port>,
+ * so on a port that is the conduit of an rtl8_4 switch, program the S-TPID
+ * to 0x8899 and the C-TPID to the constant 0x0000 second word, and give the
+ * port the QinQ "core" role so the parser expects an S-tag first. It then
+ * walks over the tag, classifies L3/L4 as usual and strips the pair on
+ * egress like any QinQ frame. Measured on a GL-BE9300: a masqueraded
+ * 938 Mbit/s upload goes from 74.6% to 98.1% CPU idle, the same as with the
+ * 802.1Q-based tagger, and the "C-VID" the parser sees is the source port.
+ *
+ * Frames the L2 engine floods to the CPU port (broadcast, multicast,
+ * unknown unicast -- every ARP request and DHCP discover) pass through the
+ * egress VLAN engine, which rebuilds the tags from the parsed VIDs using the
+ * egress TPIDs. Left at their defaults that turns the head tag into a lone
+ * 0x8100 C-tag and the DSA tagger drops the frame, so alias the egress
+ * S-TPID the same way and make the CPU port an S-VLAN port that emits both
+ * tags: the flood path then reproduces 0x8899 | 0x0400 | <ctpid> | <port>.
+ * The tagger (tag_rtl8_4.c) never reads that second word, so the egress
+ * C-TPID stays 0x8100 and a nexthop C-VLAN insert on any other port (a
+ * tagged WAN) still emits a real 802.1Q tag; leaving the CPU port's egress
+ * mode unmodified instead was tried and floods nothing (dead LAN).
+ * Lookup-hit unicast reaches the CPU untouched either way.
+ *
+ * The TPID registers and the CPU port's egress mode are chip-wide, so the
+ * alias has exactly one owner: the first port evaluated as an rtl8_4 conduit,
+ * whether at open or when DSA attaches to it later. A second conduit, or a
+ * conduit under another tagger, while the alias is owned is a board
+ * configuration this code does not support and is refused loudly. The owner
+ * restores the reset values as soon as it leaves the aliased state: on close,
+ * on a DSA tag-protocol change (conduit down, change, up) and when DSA
+ * detaches from a running conduit.
+ *
+ * Verified on the same board with the alias active: broadcast arriving on
+ * the (non-conduit) WAN port still reaches the CPU intact (ARP requests to
+ * the WAN address answered 10/10), and a VLAN-tagged WAN (wan.10) behaves
+ * exactly as under the 802.1Q tagger. With the ingress C-TPID at 0x0000 an
+ * 802.1Q tag arriving on the WAN is only parsed if the hardware matches
+ * 0x8100 natively; a WAN-ingress offload milestone has to check that.
+ */
+#if IS_ENABLED(CONFIG_NET_DSA)
+/* PPE port that owns the chip-wide alias, or -1. One PPE per SoC. */
+static int edma_parser_alias_owner = -1;
+
+static int edma_port_parser_alias_program(struct ppe_port *ppe_port,
+					  bool rtl8_4)
+{
+	struct regmap *regmap = ppe_port->ppe_dev->regmap;
+	u32 in_tpid, eg_tpid, cpu_eg;
+	int ret;
+
+	if (rtl8_4) {
+		in_tpid = FIELD_PREP(PPE_VLAN_TPID_STAG, ETH_P_REALTEK) |
+			  FIELD_PREP(PPE_VLAN_TPID_CTAG, 0);
+		/* The C-TPID keeps its reset value, see above. */
+		eg_tpid = FIELD_PREP(PPE_EG_VLAN_TPID_STPID, ETH_P_REALTEK) |
+			  FIELD_PREP(PPE_EG_VLAN_TPID_CTPID, ETH_P_8021Q);
+		/* S-VLAN port type, both tags re-inserted, port mode rather
+		 * than per-VSI mode.
+		 */
+		cpu_eg = PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |
+			 FIELD_PREP(PPE_PORT_EG_VLAN_TBL_CTAG_MODE,
+				    PPE_EG_VLAN_TAG_MODE_TAGGED) |
+			 FIELD_PREP(PPE_PORT_EG_VLAN_TBL_STAG_MODE,
+				    PPE_EG_VLAN_TAG_MODE_TAGGED);
+	} else {
+		in_tpid = FIELD_PREP(PPE_VLAN_TPID_STAG, ETH_P_8021AD) |
+			  FIELD_PREP(PPE_VLAN_TPID_CTAG, ETH_P_8021Q);
+		eg_tpid = FIELD_PREP(PPE_EG_VLAN_TPID_STPID, ETH_P_8021AD) |
+			  FIELD_PREP(PPE_EG_VLAN_TPID_CTPID, ETH_P_8021Q);
+		/* The reset value: tag modes per VSI. */
+		cpu_eg = FIELD_PREP(PPE_PORT_EG_VLAN_TBL_CTAG_MODE,
+				    PPE_EG_VLAN_TAG_MODE_TAGGED) |
+			 FIELD_PREP(PPE_PORT_EG_VLAN_TBL_STAG_MODE,
+				    PPE_EG_VLAN_TAG_MODE_TAGGED) |
+			 PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN;
+	}
+
+	ret = regmap_write(regmap, PPE_IPR_VLAN_TPID_ADDR, in_tpid);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(regmap, PPE_TPR_VLAN_TPID_ADDR, in_tpid);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(regmap, PPE_EG_VLAN_TPID_ADDR, eg_tpid);
+	if (ret)
+		return ret;
+
+	/* PPE port 0 is the CPU port (EDMA_CPU_PORT_PROFILE_ID). */
+	return regmap_update_bits(regmap,
+				  PPE_PORT_EG_VLAN_TBL_ADDR +
+				  PPE_PORT_EG_VLAN_TBL_INC * EDMA_CPU_PORT_PROFILE_ID,
+				  PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |
+				  PPE_PORT_EG_VLAN_TBL_CTAG_MODE |
+				  PPE_PORT_EG_VLAN_TBL_STAG_MODE |
+				  PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN, cpu_eg);
+}
+#endif
+
+static int edma_port_parser_role(struct ppe_port *ppe_port, bool core)
+{
+	if (WARN_ON_ONCE(ppe_port->port_id >= PPE_PORT_PARSING_ENTRIES))
+		return -EINVAL;
+
+	return regmap_update_bits(ppe_port->ppe_dev->regmap,
+				  PPE_PORT_PARSING_ADDR +
+				  PPE_PORT_PARSING_INC * ppe_port->port_id,
+				  PPE_PORT_PARSING_PORT_ROLE,
+				  core ? PPE_PORT_PARSING_PORT_ROLE : 0);
+}
+
+/* Parser programming states per port (edma_port_priv.parser_state). */
+enum edma_parser_state {
+	EDMA_PARSER_UNSET,	/* never programmed since open */
+	EDMA_PARSER_PLAIN,	/* edge role, no DSA involvement */
+	EDMA_PARSER_DSA_8021Q,	/* DSA conduit, reset TPIDs (802.1Q-based tagger) */
+	EDMA_PARSER_DSA_RTL8_4,	/* DSA conduit, rtl8_4 alias active */
+	EDMA_PARSER_DENIED,	/* wanted the alias, another port owns it (logged once) */
+};
+
+/* Called from ndo_open (before the link comes up) and again from the
+ * netdevice notifier whenever DSA may have attached or changed the tagger
+ * behind an already-running port. Idempotent: nothing is written unless
+ * the desired state differs from what this port last programmed.
+ */
+static int edma_port_parser_dsa_setup(struct net_device *netdev,
+				      struct ppe_port *ppe_port)
+{
+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	bool rtl8_4 = false, dsa = false;
+	enum edma_parser_state want;
+	int ret;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (netdev_uses_dsa(netdev)) {
+		const struct dsa_device_ops *ops = netdev->dsa_ptr->tag_ops;
+
+		dsa = true;
+		rtl8_4 = ops && ops->proto == DSA_TAG_PROTO_RTL8_4;
+	}
+#endif
+	want = !dsa ? EDMA_PARSER_PLAIN :
+	       rtl8_4 ? EDMA_PARSER_DSA_RTL8_4 : EDMA_PARSER_DSA_8021Q;
+	if (want == port_priv->parser_state)
+		return 0;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	/* Leaving the aliased state in any direction (tagger change, DSA
+	 * detaching from a running conduit) gives the chip-wide registers
+	 * back before anything else.
+	 */
+	if (!dsa && edma_parser_alias_owner == ppe_port->port_id) {
+		ret = edma_port_parser_alias_program(ppe_port, false);
+		if (ret)
+			return ret;
+		edma_parser_alias_owner = -1;
+	}
+
+	if (dsa) {
+		if (edma_parser_alias_owner >= 0 &&
+		    edma_parser_alias_owner != ppe_port->port_id) {
+			if (port_priv->parser_state != EDMA_PARSER_DENIED)
+				netdev_err(netdev,
+					   "PPE port %d already aliases the parser for rtl8_4; a second DSA conduit is not supported\n",
+					   edma_parser_alias_owner);
+			port_priv->parser_state = EDMA_PARSER_DENIED;
+			return -EBUSY;
+		}
+
+		ret = edma_port_parser_alias_program(ppe_port, rtl8_4);
+		if (ret) {
+			/* Do not leave the chip-wide registers half way. */
+			edma_port_parser_alias_program(ppe_port, false);
+			return ret;
+		}
+
+		edma_parser_alias_owner = rtl8_4 ? ppe_port->port_id : -1;
+	}
+#endif
+
+	ret = edma_port_parser_role(ppe_port, rtl8_4);
+	if (ret) {
+#if IS_ENABLED(CONFIG_NET_DSA)
+		if (edma_parser_alias_owner == ppe_port->port_id) {
+			edma_port_parser_alias_program(ppe_port, false);
+			edma_parser_alias_owner = -1;
+		}
+#endif
+		return ret;
+	}
+
+	port_priv->parser_state = want;
+	if (dsa)
+		netdev_info(netdev, "PPE ingress parser: DSA conduit, %s\n",
+			    rtl8_4 ? "rtl8_4 head tag aliased as QinQ" : "802.1Q tagger, reset TPIDs");
+
+	return 0;
+}
+
+/* Called from ndo_stop: the owner puts the chip-wide state back. */
+static void edma_port_parser_dsa_teardown(struct net_device *netdev,
+					  struct ppe_port *ppe_port)
+{
+	int ret;
+
+	((struct edma_port_priv *)netdev_priv(netdev))->parser_state = EDMA_PARSER_UNSET;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (edma_parser_alias_owner == ppe_port->port_id) {
+		ret = edma_port_parser_alias_program(ppe_port, false);
+		if (ret)
+			netdev_err(netdev, "failed to restore the PPE parser TPIDs: %d\n", ret);
+		edma_parser_alias_owner = -1;
+	}
+#endif
+
+	ret = edma_port_parser_role(ppe_port, false);
+	if (ret)
+		netdev_err(netdev, "failed to reset the PPE parser port role: %d\n", ret);
+}
+
+/* DSA sets up the user ports (and links them as uppers of the conduit)
+ * before it assigns the conduit's dsa_ptr, and on this board netifd has
+ * opened the conduit before any of that, so ndo_open alone never sees a DSA
+ * conduit on a cold boot. The user ports come up only after the tree is
+ * complete, so a user port's NETDEV_UP is the reliable moment to
+ * re-evaluate its conduit; NETDEV_CHANGEUPPER on the conduit itself covers
+ * later re-links. The setup is idempotent, so spurious events cost nothing.
+ */
+static int edma_port_netdev_event(struct notifier_block *nb,
+				  unsigned long event, void *ptr)
+{
+	struct net_device *netdev = netdev_notifier_info_to_dev(ptr);
+	struct edma_port_priv *port_priv;
+	int ret;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (event == NETDEV_UP) {
+		/* Only a DSA user port is of interest here; the lookup rejects
+		 * everything else with -ENODEV.
+		 */
+		struct dsa_port *dp = dsa_port_from_netdev(netdev);
+
+		if (IS_ERR(dp) || !dp->cpu_dp)
+			return NOTIFY_DONE;
+		/* The physical conduit, not dsa_port_to_conduit(): under a LAG
+		 * that would be the bond, which is not an EDMA port.
+		 */
+		netdev = dp->cpu_dp->conduit;
+	} else if (event != NETDEV_CHANGEUPPER) {
+		return NOTIFY_DONE;
+	}
+#else
+	if (event != NETDEV_CHANGEUPPER)
+		return NOTIFY_DONE;
+#endif
+
+	if (!netdev || !edma_port_is_edma_netdev(netdev) || !netif_running(netdev))
+		return NOTIFY_DONE;
+
+	port_priv = netdev_priv(netdev);
+	ret = edma_port_parser_dsa_setup(netdev, port_priv->ppe_port);
+	if (ret)
+		netdev_err(netdev, "failed to reprogram the PPE parser: %d\n", ret);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block edma_port_netdev_nb = {
+	.notifier_call = edma_port_netdev_event,
+};
+
+/* One notifier for all ports; registered with the first, dropped with the last. */
+static int edma_port_netdev_nb_users;
+
+static int edma_port_netdev_nb_get(void)
+{
+	int ret = 0;
+
+	if (!edma_port_netdev_nb_users++)
+		ret = register_netdevice_notifier(&edma_port_netdev_nb);
+	if (ret)
+		edma_port_netdev_nb_users--;
+	return ret;
+}
+
+static void edma_port_netdev_nb_put(void)
+{
+	if (!--edma_port_netdev_nb_users)
+		unregister_netdevice_notifier(&edma_port_netdev_nb);
+}
+
 static int edma_port_open(struct net_device *netdev)
 {
 	struct edma_port_priv *port_priv = (struct edma_port_priv *)netdev_priv(netdev);
 	struct ppe_port *ppe_port;
 	int port_id;
+	int ret;
 
 	if (!port_priv)
 		return -EINVAL;
@@ -112,6 +416,13 @@
 	ppe_port  = port_priv->ppe_port;
 	port_id = ppe_port->port_id;
 
+	ret = edma_port_parser_dsa_setup(netdev, ppe_port);
+	if (ret) {
+		netdev_err(netdev, "failed to program the PPE parser: %d\n", ret);
+		edma_port_parser_dsa_teardown(netdev, ppe_port);
+		return ret;
+	}
+
 	if (ppe_port->phylink)
 		phylink_start(ppe_port->phylink);
 
@@ -146,6 +457,8 @@
 	if (ppe_port->phylink)
 		phylink_stop(ppe_port->phylink);
 
+	edma_port_parser_dsa_teardown(netdev, ppe_port);
+
 	return 0;
 }
 
@@ -165,22 +478,121 @@
 	return ret;
 }
 
+static void edma_port_l3_if_update(struct net_device *netdev);
+
 static int edma_port_change_mtu(struct net_device *netdev, int mtu)
 {
 	struct edma_port_priv *port_priv = (struct edma_port_priv *)netdev_priv(netdev);
+	int ret;
 
 	if (!port_priv)
 		return -EINVAL;
 
 	netdev->mtu = mtu;
 
-	return ppe_port_set_maxframe(port_priv->ppe_port, mtu);
+	ret = ppe_port_set_maxframe(port_priv->ppe_port, mtu);
+	if (ret)
+		return ret;
+
+	/* Hardware checks arriving frames against the ingress L3
+	 * interface entry's MRU/MTU, so it has to follow the netdevice.
+	 */
+	edma_port_l3_if_update(netdev);
+
+	return 0;
 }
 
-static netdev_features_t edma_port_feature_check(__maybe_unused struct sk_buff *skb,
+static netdev_features_t edma_port_feature_check(struct sk_buff *skb,
 						 __maybe_unused struct net_device *netdev,
 						 netdev_features_t features)
 {
+	bool vlan_parseable = true;
+	int expected = ETH_HLEN;
+	unsigned int nvlan = 0;
+	int l3_off;
+
+	/* The TX checksum/TSO engine ignores skb->csum_start: no L3/L4
+	 * offsets are programmed into the TX descriptor, so the hardware
+	 * locates the headers with its own parser, which understands only
+	 * Ethernet with at most one VLAN tag. Anything inserting further
+	 * bytes ahead of the L3 header -- a DSA tagger such as RTL8_4, for
+	 * instance -- moves the headers out from under that parser, and the
+	 * checksum is then written at the wrong offset, corrupting every
+	 * offloaded frame.
+	 *
+	 * Rather than hard-code which tag protocols are safe, compare where
+	 * the L3 header will actually be with where the parser will look for
+	 * it, and fall back to software checksumming and GSO when they
+	 * differ. Ordinary framing -- including the single VLAN a tag_8021q
+	 * tagger inserts -- keeps full offload.
+	 *
+	 * Documentation/networking/dsa/dsa.rst requires a conduit driver
+	 * whose offload engine cannot parse the tag in use to fall back to
+	 * software checksumming.
+	 */
+
+	/* edma_tx_fill_desc() enables TSO from skb_is_gso() alone, not from
+	 * ip_summed, so a GSO skb that is not CHECKSUM_PARTIAL -- a
+	 * GRO-coalesced frame being forwarded, for instance -- has to be
+	 * checked too, or it keeps hardware segmentation and is sliced at
+	 * the same misplaced offsets.
+	 */
+	if (skb->ip_summed != CHECKSUM_PARTIAL && !skb_is_gso(skb))
+		return features;
+
+	l3_off = skb_network_offset(skb);
+
+	/* Only an 802.1Q tag is assumed to be one the parser follows. No
+	 * TPID register is ever programmed, so whether it also recognises
+	 * 802.1ad is unknown, and assuming it does would keep offload on a
+	 * frame whose L3 the parser never reaches; assuming it does not
+	 * merely costs offload.
+	 *
+	 * With a head-inserted tag in front these two bytes lie inside that
+	 * tag rather than being an ethertype, so the test can match on
