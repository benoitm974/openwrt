diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv4.c b/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv4.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv4.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv4.c	2026-09-30 08:15:32.920000471 +0000
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* IPv4 host table entry field encoding.
+ *
+ * key_type, fwd_cmd, syn_toggle and dst_info are hardcoded to the
+ * values the vendor SDK's own SNAT-flow host entries always use
+ * (ppe_drv_host_v4_add(): key_type=0 selects the plain-IPv4 entry
+ * variant, fwd_cmd=FAL_MAC_FRWRD=0 is "forward normally", syn_toggle
+ * and dst_info are left zero) rather than exposed as struct fields --
+ * this driver has no other host entry use case yet that would need
+ * them to vary.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/types.h>
+
+#include "ppe_host.h"
+#include "ppe_host_ipv4.h"
+#include "ppe_regs.h"
+
+/**
+ * ppe_host_ipv4_entry_encode() - Pack an IPv4 host table entry.
+ * @entry: The entry to pack.
+ * @words: Where to write the packed PPE_HOST_TBL_IPV4_ENTRY_WORDS words.
+ */
+void ppe_host_ipv4_entry_encode(const struct ppe_host_ipv4_entry *entry,
+				 u32 words[PPE_HOST_TBL_IPV4_ENTRY_WORDS])
+{
+	words[0] = entry->valid ? PPE_HOST_TBL_VALID : 0;
+	words[0] |= entry->wan ? PPE_HOST_TBL_LAN_WAN : 0;
+
+	words[1] = be32_to_cpu(entry->ip_addr);
+
+	words[2] = 0;
+}
+
+/**
+ * ppe_host_ipv4_entry_decode() - Unpack an IPv4 host table entry.
+ * @words: The packed PPE_HOST_TBL_IPV4_ENTRY_WORDS words to unpack.
+ * @entry: Where to store the unpacked entry.
+ */
+void ppe_host_ipv4_entry_decode(const u32 words[PPE_HOST_TBL_IPV4_ENTRY_WORDS],
+				 struct ppe_host_ipv4_entry *entry)
+{
+	entry->valid = !!(words[0] & PPE_HOST_TBL_VALID);
+	entry->wan = !!(words[0] & PPE_HOST_TBL_LAN_WAN);
+	entry->ip_addr = cpu_to_be32(words[1]);
+}
