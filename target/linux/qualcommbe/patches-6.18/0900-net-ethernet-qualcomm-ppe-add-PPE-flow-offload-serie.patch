diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_l3_if.c b/drivers/net/ethernet/qualcomm/ppe/ppe_l3_if.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_l3_if.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_l3_if.c	2026-09-30 08:15:32.930000471 +0000
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* PPE ingress/egress L3 interface tables. Like the nexthop table, both
+ * are addressed directly: one fixed-size entry per index, no indirect
+ * command/data/result sequence.
+ *
+ * These are per-interface resources, not per-flow: the vendor driver
+ * populates one entry per netdevice/VSI/LAG/etc at interface
+ * registration time (ppe_drv_iface_l3_if_set(), called from
+ * ppe_drv_dp.c, ppe_drv_br.c, ppe_drv_lag.c, ppe_drv_vp.c and others),
+ * and a flow/nexthop entry only ever references an already-populated
+ * index. Callers of this file are expected to follow the same pattern
+ * -- set up one entry per interface once, then reference its index
+ * from ppe_flow_ipv4_nat_entry.src_l3_if / ppe_nexthop_entry.post_l3_if.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/etherdevice.h>
+#include <linux/regmap.h>
+
+#include "ppe.h"
+#include "ppe_l3_if.h"
+#include "ppe_regs.h"
+
+/**
+ * ppe_l3_if_in_entry_set() - Write a PPE ingress L3 interface table entry.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to write.
+ * @entry: The ingress L3 interface entry to write.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_l3_if_in_entry_set(struct ppe_device *ppe_dev, u32 index,
+			    const struct ppe_l3_if_in_entry *entry)
+{
+	u32 base, val[PPE_IN_L3_IF_TBL_WORDS] = {};
+	int ret;
+	int i;
+
+	if (index >= PPE_IN_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
+	/* FIELD_PREP() would silently truncate these to the field width. */
+	if (entry->mru > FIELD_MAX(PPE_IN_L3_IF_TBL_MRU) ||
+	    entry->mtu > FIELD_MAX(PPE_IN_L3_IF_TBL_MTU) ||
+	    entry->mru_ipv6 > FIELD_MAX(PPE_IN_L3_IF_TBL_MRU_IPV6) ||
+	    entry->mtu_ipv6 > FIELD_MAX(PPE_IN_L3_IF_TBL_MTU_IPV6))
+		return -EINVAL;
+
+	val[0] = FIELD_PREP(PPE_IN_L3_IF_TBL_MRU, entry->mru);
+	val[0] |= FIELD_PREP(PPE_IN_L3_IF_TBL_MTU, entry->mtu);
+	val[0] |= entry->ttl_dec_bypass ? PPE_IN_L3_IF_TBL_TTL_DEC_BYPASS : 0;
+	val[0] |= entry->ipv4_uc_route_en ? PPE_IN_L3_IF_TBL_IPV4_UC_ROUTE_EN : 0;
+	val[0] |= entry->ipv6_uc_route_en ? PPE_IN_L3_IF_TBL_IPV6_UC_ROUTE_EN : 0;
+	val[0] |= entry->icmp_trigger_en ? PPE_IN_L3_IF_TBL_ICMP_TRIGGER_EN : 0;
+
+	val[1] = FIELD_PREP(PPE_IN_L3_IF_TBL_TTL_EXCEED_CMD, entry->ttl_exceed_cmd);
+	val[1] |= entry->ttl_exceed_de_acce ? PPE_IN_L3_IF_TBL_TTL_EXCEED_DE_ACCE : 0;
+	val[1] |= FIELD_PREP(PPE_IN_L3_IF_TBL_MAC_BITMAP, entry->mac_bitmap);
+	val[1] |= entry->pppoe_en ? PPE_IN_L3_IF_TBL_PPPOE_EN : 0;
+	val[1] |= FIELD_PREP(PPE_IN_L3_IF_TBL_MRU_IPV6, entry->mru_ipv6);
+
+	val[2] = FIELD_PREP(PPE_IN_L3_IF_TBL_MTU_IPV6, entry->mtu_ipv6);
+
+	base = PPE_IN_L3_IF_TBL_ADDR + index * PPE_IN_L3_IF_TBL_INC;
+	for (i = 0; i < PPE_IN_L3_IF_TBL_WORDS; i++) {
+		ret = regmap_write(ppe_dev->regmap, base + i * 4, val[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_l3_if_in_entry_get() - Read a PPE ingress L3 interface table entry.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to read.
+ * @entry: Where to store the entry read back.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_l3_if_in_entry_get(struct ppe_device *ppe_dev, u32 index,
+			    struct ppe_l3_if_in_entry *entry)
+{
+	u32 base, val[PPE_IN_L3_IF_TBL_WORDS];
+	int ret;
+	int i;
+
+	if (index >= PPE_IN_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
+	base = PPE_IN_L3_IF_TBL_ADDR + index * PPE_IN_L3_IF_TBL_INC;
+	for (i = 0; i < PPE_IN_L3_IF_TBL_WORDS; i++) {
+		ret = regmap_read(ppe_dev->regmap, base + i * 4, &val[i]);
+		if (ret)
+			return ret;
+	}
+
+	entry->mru = FIELD_GET(PPE_IN_L3_IF_TBL_MRU, val[0]);
+	entry->mtu = FIELD_GET(PPE_IN_L3_IF_TBL_MTU, val[0]);
+	entry->ttl_dec_bypass = !!(val[0] & PPE_IN_L3_IF_TBL_TTL_DEC_BYPASS);
+	entry->ipv4_uc_route_en = !!(val[0] & PPE_IN_L3_IF_TBL_IPV4_UC_ROUTE_EN);
+	entry->ipv6_uc_route_en = !!(val[0] & PPE_IN_L3_IF_TBL_IPV6_UC_ROUTE_EN);
+	entry->icmp_trigger_en = !!(val[0] & PPE_IN_L3_IF_TBL_ICMP_TRIGGER_EN);
+
+	entry->ttl_exceed_cmd = FIELD_GET(PPE_IN_L3_IF_TBL_TTL_EXCEED_CMD, val[1]);
+	entry->ttl_exceed_de_acce = !!(val[1] & PPE_IN_L3_IF_TBL_TTL_EXCEED_DE_ACCE);
+	entry->mac_bitmap = FIELD_GET(PPE_IN_L3_IF_TBL_MAC_BITMAP, val[1]);
+	entry->pppoe_en = !!(val[1] & PPE_IN_L3_IF_TBL_PPPOE_EN);
+	entry->mru_ipv6 = FIELD_GET(PPE_IN_L3_IF_TBL_MRU_IPV6, val[1]);
+	entry->mtu_ipv6 = FIELD_GET(PPE_IN_L3_IF_TBL_MTU_IPV6, val[2]);
+
+	return 0;
+}
+
+/**
+ * ppe_l3_if_eg_entry_set() - Write a PPE egress L3 interface table entry.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to write.
+ * @entry: The egress L3 interface entry to write.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_l3_if_eg_entry_set(struct ppe_device *ppe_dev, u32 index,
+			    const struct ppe_l3_if_eg_entry *entry)
+{
+	u32 base, val[3] = {};
+	u64 mac;
+	int ret;
+	int i;
+
+	if (index >= PPE_EG_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
+	mac = ether_addr_to_u64(entry->mac_addr);
+
+	val[0] = mac & GENMASK(31, 0);
+
+	val[1] = FIELD_PREP(PPE_EG_L3_IF_TBL_MAC_ADDR_1, mac >> 32);
+	val[1] |= FIELD_PREP(PPE_EG_L3_IF_TBL_SESSION_ID, entry->session_id);
+
+	val[2] = entry->pppoe_en ? PPE_EG_L3_IF_TBL_PPPOE_EN : 0;
+
+	base = PPE_EG_L3_IF_TBL_ADDR + index * PPE_EG_L3_IF_TBL_INC;
+	for (i = 0; i < 3; i++) {
+		ret = regmap_write(ppe_dev->regmap, base + i * 4, val[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_l3_if_eg_entry_get() - Read a PPE egress L3 interface table entry.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to read.
+ * @entry: Where to store the entry read back.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_l3_if_eg_entry_get(struct ppe_device *ppe_dev, u32 index,
+			    struct ppe_l3_if_eg_entry *entry)
+{
+	u32 base, val[3];
+	u64 mac;
+	int ret;
+	int i;
+
+	if (index >= PPE_EG_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
+	base = PPE_EG_L3_IF_TBL_ADDR + index * PPE_EG_L3_IF_TBL_INC;
+	for (i = 0; i < 3; i++) {
+		ret = regmap_read(ppe_dev->regmap, base + i * 4, &val[i]);
+		if (ret)
+			return ret;
+	}
+
+	mac = (u64)FIELD_GET(PPE_EG_L3_IF_TBL_MAC_ADDR_1, val[1]) << 32 | val[0];
+	u64_to_ether_addr(mac, entry->mac_addr);
+
+	entry->session_id = FIELD_GET(PPE_EG_L3_IF_TBL_SESSION_ID, val[1]);
+	entry->pppoe_en = !!(val[2] & PPE_EG_L3_IF_TBL_PPPOE_EN);
+
+	return 0;
+}
+
+/**
+ * ppe_my_mac_entry_set() - Write a PPE MY_MAC table entry.
+ * @ppe_dev: PPE device.
+ * @index: The entry index to write.
+ * @mac_addr: The MAC address hardware should treat as its own.
+ * @valid: Whether the entry is active. When false, @mac_addr is
+ * ignored and the entry is cleared.
+ *
+ * An ingress L3 interface selects the entries that apply to it through
+ * its MAC_BITMAP, so an entry written here only takes effect once some
+ * interface names it.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_my_mac_entry_set(struct ppe_device *ppe_dev, u32 index,
+			  const u8 *mac_addr, bool valid)
+{
+	u32 base, val[2] = {};
+	u64 mac;
+	int ret;
+	int i;
+
+	if (index >= PPE_MY_MAC_TBL_ENTRIES)
+		return -EINVAL;
+
+	if (valid) {
+		mac = ether_addr_to_u64(mac_addr);
+		val[0] = mac & GENMASK(31, 0);
+		val[1] = FIELD_PREP(PPE_MY_MAC_TBL_MAC_DA_1, mac >> 32);
+		val[1] |= PPE_MY_MAC_TBL_VALID;
+	}
+
+	base = PPE_MY_MAC_TBL_ADDR + index * PPE_MY_MAC_TBL_INC;
+	for (i = 0; i < 2; i++) {
+		ret = regmap_write(ppe_dev->regmap, base + i * 4, val[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * ppe_l3_if_port_bind() - Bind a port to an ingress L3 interface entry.
+ * @ppe_dev: PPE device.
+ * @port_id: The port whose arriving frames the binding applies to.
+ * @l3_if_index: The ingress L3 interface table index to consult.
+ * @valid: Whether the binding is active.
+ *
+ * The rest of this table entry holds unrelated source-guard
+ * configuration, so only the two L3 interface fields are updated.
+ *
+ * Return: 0 on success, a negative error code on failure.
+ */
+int ppe_l3_if_port_bind(struct ppe_device *ppe_dev, u32 port_id,
+			 u32 l3_if_index, bool valid)
+{
+	u32 addr, val[PPE_L3_VP_PORT_TBL_WORDS];
+	int ret;
+	int i;
+
+	if (port_id >= PPE_L3_VP_PORT_TBL_ENTRIES ||
+	    l3_if_index >= PPE_IN_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
+	addr = PPE_L3_VP_PORT_TBL_ADDR + port_id * PPE_L3_VP_PORT_TBL_INC;
+
+	/* The entry only latches when every word is written, so read it
+	 * back, change the two L3 interface fields and write the whole
+	 * entry out again -- writing word 0 alone is silently dropped.
+	 */
+	for (i = 0; i < PPE_L3_VP_PORT_TBL_WORDS; i++) {
+		ret = regmap_read(ppe_dev->regmap, addr + i * 4, &val[i]);
+		if (ret)
+			return ret;
+	}
+
+	val[0] &= ~(PPE_L3_VP_PORT_TBL_L3_IF_VALID |
+		    PPE_L3_VP_PORT_TBL_L3_IF_INDEX);
+	if (valid)
+		val[0] |= PPE_L3_VP_PORT_TBL_L3_IF_VALID |
+			  FIELD_PREP(PPE_L3_VP_PORT_TBL_L3_IF_INDEX, l3_if_index);
+
+	for (i = 0; i < PPE_L3_VP_PORT_TBL_WORDS; i++) {
+		ret = regmap_write(ppe_dev->regmap, addr + i * 4, val[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
