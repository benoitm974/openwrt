+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __PPE_FLOW_IPV4_H__
+#define __PPE_FLOW_IPV4_H__
+
+#include <linux/types.h>
+
+#include "ppe_flow.h"
+
+/**
+ * enum ppe_flow_protocol - Layer-4 protocol matched by a flow entry.
+ */
+enum ppe_flow_protocol {
+	PPE_FLOW_PROTO_OTHER = 0,
+	PPE_FLOW_PROTO_TCP = 1,
+	PPE_FLOW_PROTO_UDP = 2,
+	PPE_FLOW_PROTO_UDPLITE = 3,
+};
+
+/**
+ * enum ppe_flow_fwd_type - Forwarding action performed by a flow entry.
+ * Hardware field width is 3 bits. The SNAT and DNAT overlays are
+ * bit-for-bit identical (the vendor's in_flow_tbl_0 and in_flow_tbl_3
+ * differ only in the names of the nexthop and L4 port fields), so one
+ * encoder serves both; the other forward types have different layouts
+ * (struct in_flow_tbl_0 in the vendor SDK) has been implemented so far
+ * -- DNAT/ROUTE/BRIDGE each reuse the same word 1 bit range for
+ * different fields and need their own entry struct/encode function.
+ */
+enum ppe_flow_fwd_type {
+	PPE_FLOW_FWD_FORWARD = 0,
+	PPE_FLOW_FWD_SNAT = 1,
+	PPE_FLOW_FWD_DNAT = 2,
+	PPE_FLOW_FWD_ROUTE = 3,
+	PPE_FLOW_FWD_BRIDGE = 4,
+	PPE_FLOW_FWD_DROP = 5,
+	PPE_FLOW_FWD_RDT_TO_CPU = 6,
+};
+
+/**
+ * struct ppe_flow_ipv4_nat_entry - IPv4 5-tuple flow entry, NAT variants.
+ * @valid: Whether this entry is active.
+ * @host_addr_is_dst: @host_addr_index refers to the destination IP's host
+ * table entry when true, the source IP's when false. The endpoint this
+ * does *not* refer to is @match_ip below.
+ * @host_addr_index: Host table index (see ppe_host.h) for the endpoint
+ * selected by @host_addr_is_dst.
+ * @protocol: Layer-4 protocol to match.
+ * @age: Hardware aging counter; write 0 on entry creation, hardware
+ * updates it as traffic hits the entry.
+ * @src_l3_if_valid: Whether @src_l3_if should be matched.
+ * @src_l3_if: Source L3 interface index to match, when @src_l3_if_valid.
+ * @fwd_type: PPE_FLOW_FWD_SNAT or PPE_FLOW_FWD_DNAT. Selects which
+ * address the nexthop and L4 port rewrite: the source (outbound
+ * masquerade) or the destination (the reply direction).
+ * @nat_nexthop: Nexthop table index (see ppe_nexthop.h) this flow's
+ * traffic egresses through after SNAT rewrite.
+ * @nat_l4_port: L4 port to rewrite matched packets to -- source for
+ * SNAT, destination for DNAT.
+ * @deacclr_en: Whether to de-accelerate this flow. NOT conditional: hardware
+ * applies it to every packet matching the entry, and the action is the global
+ * L3_ROUTE_CTRL.FLOW_DE_ACCE_CMD, which resets to 3 (redirect to CPU). Setting
+ * this therefore disables acceleration for the flow entirely; it is not a way
+ * to except TCP control flags, which is what the parser-level exceptions in
+ * ppe_offload_tcp_exception_init() are for.
+ * @copy_to_cpu: Whether to also copy matched packets to the CPU path.
+ * @syn_toggle: Updated by hardware; not meaningful to set on creation.
+ * @pri_profile: QoS priority profile index for this flow.
+ * @service_code: Service code applied to matched packets.
+ * @match_ip: The 5-tuple match IP address for the endpoint not covered
+ * by @host_addr_index (network byte order).
+ * @match_sport: Source port to match.
+ * @match_dport: Destination port to match.
+ * @pmtu: Path MTU matched packets are checked against before being
+ * forwarded; a packet exceeding it is redirected to the CPU. Must be
+ * set -- 0 would fail every packet.
+ * @pmtu_check_l3: Compare @pmtu against the L3 packet length (true) or
+ * the length including the L2 header (false).
+ */
+struct ppe_flow_ipv4_nat_entry {
+	bool valid;
+	enum ppe_flow_fwd_type fwd_type;
+	bool host_addr_is_dst;
+	u16 host_addr_index;
+	enum ppe_flow_protocol protocol;
+	u8 age;
+	bool src_l3_if_valid;
+	u8 src_l3_if;
+	u16 nat_nexthop;
+	u16 nat_l4_port;
+	bool deacclr_en;
+	bool copy_to_cpu;
+	u8 syn_toggle;
+	u8 pri_profile;
+	u8 service_code;
+	__be32 match_ip;
+	u16 match_sport;
+	u16 match_dport;
+	u16 pmtu;
+	bool pmtu_check_l3;
+};
+
+void ppe_flow_ipv4_nat_entry_encode(const struct ppe_flow_ipv4_nat_entry *entry,
+				      u32 words[PPE_FLOW_TBL_ENTRY_WORDS]);
+void ppe_flow_ipv4_nat_entry_decode(const u32 words[PPE_FLOW_TBL_ENTRY_WORDS],
+				      struct ppe_flow_ipv4_nat_entry *entry);
+
+#endif
