+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_pub_ip_pool.c	2026-09-30 08:15:32.920000471 +0000
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* Refcounted, deduplicating allocator on top of the public IP address
+ * table primitive (ppe_pub_ip.c). See ppe_pub_ip_pool.h for why this
+ * needs its own software dedup, same reasoning as ppe_nexthop_pool.c.
+ */
+
+#include <linux/errno.h>
+#include <linux/list.h>
+#include <linux/refcount.h>
+
+#include "ppe.h"
+#include "ppe_pub_ip.h"
+#include "ppe_pub_ip_pool.h"
+
+/**
+ * ppe_pub_ip_pool_init() - Initialize a public IP table pool.
+ * @pool: The pool to initialize.
+ */
+void ppe_pub_ip_pool_init(struct ppe_pub_ip_pool *pool)
+{
+	unsigned int i;
+
+	INIT_LIST_HEAD(&pool->free);
+	INIT_LIST_HEAD(&pool->active);
+	mutex_init(&pool->lock);
+
+	for (i = 0; i < PPE_PUB_IP_ADDR_TBL_ENTRIES; i++) {
+		pool->entry[i].index = i;
+		pool->entry[i].active = false;
+		list_add_tail(&pool->entry[i].list, &pool->free);
+	}
+}
+
+/**
+ * ppe_pub_ip_pool_destroy() - Tear down a public IP table pool.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to tear down.
+ *
+ * Clears every hardware entry the pool is still tracking. Callers are
+ * expected to have already stopped issuing get/deref calls against
+ * this pool.
+ */
+void ppe_pub_ip_pool_destroy(struct ppe_device *ppe_dev, struct ppe_pub_ip_pool *pool)
+{
+	struct ppe_pub_ip_pool_entry *e, *tmp;
+
+	list_for_each_entry_safe(e, tmp, &pool->active, list)
+		ppe_pub_ip_entry_set(ppe_dev, e->index, 0);
+}
+
+/**
+ * ppe_pub_ip_pool_get_and_ref() - Add a public IP entry, or ref a matching one.
+ * @ppe_dev: PPE device.
+ * @pool: The pool to allocate from.
+ * @ip_addr: The IPv4 address to write, or match against an already-active one.
+ * @index: On success, the entry's hardware index (new or reused).
+ *
+ * Return: 0 on success, a negative error code on failure (-ENOSPC if
+ * the table is full).
+ */
+int ppe_pub_ip_pool_get_and_ref(struct ppe_device *ppe_dev, struct ppe_pub_ip_pool *pool,
+				 __be32 ip_addr, u32 *index)
+{
+	struct ppe_pub_ip_pool_entry *e;
+	int ret;
+
+	mutex_lock(&pool->lock);
+
+	list_for_each_entry(e, &pool->active, list) {
+		if (e->ip_addr == ip_addr) {
+			refcount_inc(&e->ref);
+			mutex_unlock(&pool->lock);
+			*index = e->index;
+			return 0;
+		}
+	}
+
+	e = list_first_entry_or_null(&pool->free, struct ppe_pub_ip_pool_entry, list);
+	if (!e) {
+		mutex_unlock(&pool->lock);
+		return -ENOSPC;
+	}
+
+	ret = ppe_pub_ip_entry_set(ppe_dev, e->index, ip_addr);
+	if (ret) {
+		mutex_unlock(&pool->lock);
+		return ret;
+	}
+
+	e->ip_addr = ip_addr;
+	e->active = true;
+	refcount_set(&e->ref, 1);
+	list_move_tail(&e->list, &pool->active);
+
+	mutex_unlock(&pool->lock);
+	*index = e->index;
+
+	return 0;
+}
+
+/**
+ * ppe_pub_ip_pool_deref() - Drop a reference on a pooled public IP entry.
+ * @ppe_dev: PPE device.
+ * @pool: The pool @index was allocated from.
+ * @index: The entry index, as returned by ppe_pub_ip_pool_get_and_ref().
+ *
+ * Clears the underlying hardware entry once its last reference is
+ * dropped.
+ */
+void ppe_pub_ip_pool_deref(struct ppe_device *ppe_dev, struct ppe_pub_ip_pool *pool, u32 index)
+{
+	struct ppe_pub_ip_pool_entry *e;
+
+	if (index >= PPE_PUB_IP_ADDR_TBL_ENTRIES)
+		return;
+
+	mutex_lock(&pool->lock);
+
+	e = &pool->entry[index];
+	if (!e->active) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	if (!refcount_dec_and_test(&e->ref)) {
+		mutex_unlock(&pool->lock);
+		return;
+	}
+
+	e->active = false;
+	e->ip_addr = 0;
+	list_move_tail(&e->list, &pool->free);
+
+	mutex_unlock(&pool->lock);
+
+	ppe_pub_ip_entry_set(ppe_dev, index, 0);
+}
