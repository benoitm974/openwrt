+#ifndef __PPE_NEXTHOP_POOL_H__
+#define __PPE_NEXTHOP_POOL_H__
+
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/refcount.h>
+#include <linux/types.h>
+
+#include "ppe.h"
+#include "ppe_nexthop.h"
+#include "ppe_regs.h"
+
+struct ppe_nexthop_pool_entry {
+	struct list_head list;
+	refcount_t ref;
+	u32 index;
+	bool active;
+	struct ppe_nexthop_entry key;
+};
+
+/**
+ * struct ppe_nexthop_pool - Deduplicating, refcounted nexthop table allocator.
+ * @entry: One entry per hardware index, threaded onto @free or @active.
+ * @free: Indices not currently programmed into hardware.
+ * @active: Indices currently programmed, each holding a copy of the
+ * entry it was programmed with in @entry[i].key, for matching future
+ * requests against.
+ * @lock: Serializes get/deref against concurrent callers.
+ *
+ * Unlike the host table, the nexthop table is direct-addressed with no
+ * hardware-side dedup: two identical entries programmed at different
+ * indices are simply two separate, independent hardware entries. This
+ * pool does the same linear-search-then-allocate-or-reuse dedup the
+ * vendor SDK's ppe_drv_nexthop_v4_get_and_ref()/ppe_drv_nexthop_v4_match()
+ * do in software, backed by a fixed array sized to the hardware table
+ * instead of a kzalloc-per-entry list, since the table's size
+ * (PPE_IN_NEXTHOP_TBL_ENTRIES) is fixed and known up front.
+ */
+struct ppe_nexthop_pool {
+	struct ppe_nexthop_pool_entry entry[PPE_IN_NEXTHOP_TBL_ENTRIES];
+	struct list_head free;
+	struct list_head active;
+	struct mutex lock;
+};
+
+void ppe_nexthop_pool_init(struct ppe_nexthop_pool *pool);
+void ppe_nexthop_pool_destroy(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool);
+
+int ppe_nexthop_pool_get_and_ref(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool,
+				  const struct ppe_nexthop_entry *key, u32 *index);
+void ppe_nexthop_pool_deref(struct ppe_device *ppe_dev, struct ppe_nexthop_pool *pool, u32 index);
+
+#endif
