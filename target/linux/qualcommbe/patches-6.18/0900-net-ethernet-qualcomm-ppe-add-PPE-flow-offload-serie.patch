+/* Values for PPE_IN_FLOW_TBL_OP's OP_TYPE field. */
+enum ppe_flow_tbl_op_type {
+	PPE_FLOW_TBL_OP_ADD = 0,
+	PPE_FLOW_TBL_OP_DEL,
+	PPE_FLOW_TBL_OP_GET,
+	PPE_FLOW_TBL_OP_FLUSH,
+};
+
+/* Per-table command tag, mirroring the vendor SDK's hppe_flow.c
+ * flow_cmd_id -- see ppe_host_cmd_id in ppe_host.c.
+ */
+static u32 ppe_flow_cmd_id;
+
+/* Trigger the given flow table operation and wait for hardware to
+ * complete it. *index is the entry index to operate on for
+ * PPE_FLOW_OP_MODE_INDEX (input); for PPE_FLOW_OP_MODE_HASH it is
+ * ignored on input and set to the hardware-assigned index on success.
+ */
+static int ppe_flow_tbl_op_wait(struct ppe_device *ppe_dev,
+				 enum ppe_flow_tbl_op_type op_type,
+				 enum ppe_flow_op_mode mode, u32 *index)
+{
+	u32 val, rslt, cmd_id;
+	int ret;
+
+	cmd_id = ppe_flow_cmd_id++ & FIELD_MAX(PPE_IN_FLOW_TBL_OP_CMD_ID);
+
+	val = FIELD_PREP(PPE_IN_FLOW_TBL_OP_CMD_ID, cmd_id);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_OP_TYPE, op_type);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_HASH_BLOCK_BITMAP, 3);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_OP_MODE, mode);
+	val |= FIELD_PREP(PPE_IN_FLOW_TBL_OP_ENTRY_INDEX, *index);
+
+	ret = regmap_write(ppe_dev->regmap, PPE_IN_FLOW_TBL_OP_ADDR, val);
+	if (ret)
+		return ret;
+
+	/* VALID_CNT is a counter, not a one-shot valid bit, and nothing clears
+	 * it between operations -- a stale result left by a previous op would
+	 * otherwise satisfy the poll immediately and we would adopt ITS entry
+	 * index. Match the command tag we just issued, which is what the tag is
+	 * for, so an add cannot return a foreign index (leaving the entry we
+	 * actually programmed untracked and never deleted) and a delete cannot
+	 * remove an unrelated live flow.
+	 */
+	ret = regmap_read_poll_timeout(ppe_dev->regmap, PPE_IN_FLOW_TBL_OP_RSLT_ADDR,
+					rslt,
+					FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_VALID_CNT, rslt) &&
+					FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_CMD_ID, rslt) == cmd_id,
+					10, 2000);
+	if (ret)
+		return ret;
