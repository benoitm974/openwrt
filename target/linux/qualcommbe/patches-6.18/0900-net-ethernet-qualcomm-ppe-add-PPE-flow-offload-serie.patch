+ */
+int ppe_flow_counter_get(struct ppe_device *ppe_dev, u32 index,
+			 u64 *packets, u64 *bytes)
+{
+	u32 addr, pkt, lo, hi, hi_again;
+	int ret, tries;
+
+	if (index >= PPE_IN_FLOW_CNT_TBL_ENTRIES)
+		return -EINVAL;
+
+	addr = PPE_IN_FLOW_CNT_TBL_ADDR + index * PPE_IN_FLOW_CNT_TBL_INC;
+
+	ret = regmap_read(ppe_dev->regmap, addr, &pkt);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(ppe_dev->regmap, addr + 2 * sizeof(u32), &hi);
+	if (ret)
+		return ret;
+
+	/* Bounded: each retry needs another 32-bit carry to race us again. */
+	for (tries = 0; tries < 3; tries++) {
+		ret = regmap_read(ppe_dev->regmap, addr + sizeof(u32), &lo);
+		if (ret)
+			return ret;
+
+		ret = regmap_read(ppe_dev->regmap, addr + 2 * sizeof(u32), &hi_again);
+		if (ret)
+			return ret;
+
+		if (hi_again == hi)
+			break;
+
+		hi = hi_again;
+	}
+
+	*packets = pkt;
+	*bytes = (u64)FIELD_GET(PPE_IN_FLOW_CNT_TBL_BYTE_HI, hi) << 32 | lo;
+
+	return 0;
+}
