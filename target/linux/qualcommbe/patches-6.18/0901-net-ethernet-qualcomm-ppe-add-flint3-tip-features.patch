diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv4.h b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv4.h
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv4.h	2026-10-01 16:58:26.770008427 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv4.h	2026-10-01 16:58:27.330008428 +0000
