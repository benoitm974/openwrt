From: Kamil Bienkiewicz <perceivalpercy@gmail.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: flint3 tip features (0448-0456)

Port of perceival/openwrt-flint3 flint3-be9300 patches 0448-0456 on top
of our 0900 series port (all by Kamil Bienkiewicz):

- 0448 L4 port mangle in packet byte order
- 0449 reply-direction offload towards DSA user ports
- 0450 follow bridge FDB moves for port-addressed flows
- 0451 routed IPv6 flow offload
- 0452 re-arm a flow whose hardware entry stopped matching
- 0453 stop following a flapping address
- 0454 IPv6 flow-entry lifecycle self-test at init
- 0455 say when the flow table is full
- 0456 quiet flow re-arms while the table is full

Skipped: 0447 (mdio-ipq4019 busy-spin, Flint3 RTL8372N-specific polish,
not needed on the BE800). Port fix: include <linux/device.h> in
ppe_flow.c for dev_warn on 6.18.44.

Upstream-Status: inappropriate / WIP port - see docs/be800-ppe-offload.md
Signed-off-by: Kamil Bienkiewicz <perceivalpercy@gmail.com>
[BE800 port]
Signed-off-by: Benoit Masson <yahoo@perenite.com>
---
diff -ruN a/drivers/net/ethernet/qualcomm/ppe/edma_port.c b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c	2026-10-01 16:58:26.770008427 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c	2026-10-01 16:58:27.330008428 +0000
@@ -137,8 +137,10 @@
  * the (non-conduit) WAN port still reaches the CPU intact (ARP requests to
  * the WAN address answered 10/10), and a VLAN-tagged WAN (wan.10) behaves
  * exactly as under the 802.1Q tagger. With the ingress C-TPID at 0x0000 an
- * 802.1Q tag arriving on the WAN is only parsed if the hardware matches
- * 0x8100 natively; a WAN-ingress offload milestone has to check that.
+ * 802.1Q tag arriving on the WAN is not parsed as a VLAN (measured: flows
+ * entering through a tagged WAN never hit in hardware), so ppe_offload.c
+ * declines such flows while the alias is active,
+ * see edma_port_parser_alias_active().
  */
 #if IS_ENABLED(CONFIG_NET_DSA)
 /* PPE port that owns the chip-wide alias, or -1. One PPE per SoC. */
@@ -151,6 +153,10 @@
 	u32 in_tpid, eg_tpid, cpu_eg;
 	int ret;
 
+	/* The conduit's own egress VLAN entry is written last, below. */
+	if (WARN_ON_ONCE(ppe_port->port_id >= PPE_PORT_EG_VLAN_TBL_ENTRIES))
+		return -EINVAL;
+
 	if (rtl8_4) {
 		in_tpid = FIELD_PREP(PPE_VLAN_TPID_STAG, ETH_P_REALTEK) |
 			  FIELD_PREP(PPE_VLAN_TPID_CTAG, 0);
@@ -191,13 +197,44 @@
 		return ret;
 
 	/* PPE port 0 is the CPU port (EDMA_CPU_PORT_PROFILE_ID). */
+	ret = regmap_update_bits(regmap,
+				 PPE_PORT_EG_VLAN_TBL_ADDR +
+				 PPE_PORT_EG_VLAN_TBL_INC * EDMA_CPU_PORT_PROFILE_ID,
+				 PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |
+				 PPE_PORT_EG_VLAN_TBL_CTAG_MODE |
+				 PPE_PORT_EG_VLAN_TBL_STAG_MODE |
+				 PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN, cpu_eg);
+	if (ret)
+		return ret;
+
+	/* The conduit itself becomes an S-VLAN port too, keeping its
+	 * per-VSI tag modes: a routed flow's nexthop can then insert the
+	 * S-tag + C-tag pair that emulates the head tag towards the switch
+	 * (ppe_offload.c). Measured on a GL-BE9300: with the port left a
+	 * C-VLAN port the switch delivered nothing for such flows, with this
+	 * bit set the same flows ran at 2353 Mbit/s, and DHCP, ARP and the
+	 * software path were unaffected either way.
+	 */
 	return regmap_update_bits(regmap,
 				  PPE_PORT_EG_VLAN_TBL_ADDR +
-				  PPE_PORT_EG_VLAN_TBL_INC * EDMA_CPU_PORT_PROFILE_ID,
-				  PPE_PORT_EG_VLAN_TBL_VLAN_TYPE |
-				  PPE_PORT_EG_VLAN_TBL_CTAG_MODE |
-				  PPE_PORT_EG_VLAN_TBL_STAG_MODE |
-				  PPE_PORT_EG_VLAN_TBL_VSI_TAG_MODE_EN, cpu_eg);
+				  PPE_PORT_EG_VLAN_TBL_INC * ppe_port->port_id,
+				  PPE_PORT_EG_VLAN_TBL_VLAN_TYPE,
+				  rtl8_4 ? PPE_PORT_EG_VLAN_TBL_VLAN_TYPE : 0);
+}
+
+/**
+ * edma_port_parser_alias_active() - Whether the rtl8_4 parser alias is on.
+ *
+ * The alias is chip-wide (one owner), and while it holds, the ingress
+ * C-TPID is 0x0000 on every port: an 802.1Q tag arriving on the WAN is
+ * not parsed as a VLAN at all. Measured on a GL-BE9300: flows entering
+ * through a VLAN-tagged WAN then never hit in hardware.
+ *
+ * Return: true while a conduit owns the alias.
+ */
+bool edma_port_parser_alias_active(void)
+{
+	return READ_ONCE(edma_parser_alias_owner) >= 0;
 }
 #endif
 
@@ -213,15 +250,6 @@
 				  core ? PPE_PORT_PARSING_PORT_ROLE : 0);
 }
 
-/* Parser programming states per port (edma_port_priv.parser_state). */
-enum edma_parser_state {
-	EDMA_PARSER_UNSET,	/* never programmed since open */
-	EDMA_PARSER_PLAIN,	/* edge role, no DSA involvement */
-	EDMA_PARSER_DSA_8021Q,	/* DSA conduit, reset TPIDs (802.1Q-based tagger) */
-	EDMA_PARSER_DSA_RTL8_4,	/* DSA conduit, rtl8_4 alias active */
-	EDMA_PARSER_DENIED,	/* wanted the alias, another port owns it (logged once) */
-};
-
 /* Called from ndo_open (before the link comes up) and again from the
  * netdevice notifier whenever DSA may have attached or changed the tagger
  * behind an already-running port. Idempotent: nothing is written unless
@@ -257,7 +285,7 @@
 		ret = edma_port_parser_alias_program(ppe_port, false);
 		if (ret)
 			return ret;
-		edma_parser_alias_owner = -1;
+		WRITE_ONCE(edma_parser_alias_owner, -1);
 	}
 
 	if (dsa) {
@@ -278,7 +306,7 @@
 			return ret;
 		}
 
-		edma_parser_alias_owner = rtl8_4 ? ppe_port->port_id : -1;
+		WRITE_ONCE(edma_parser_alias_owner, rtl8_4 ? ppe_port->port_id : -1);
 	}
 #endif
 
@@ -287,7 +315,7 @@
 #if IS_ENABLED(CONFIG_NET_DSA)
 		if (edma_parser_alias_owner == ppe_port->port_id) {
 			edma_port_parser_alias_program(ppe_port, false);
-			edma_parser_alias_owner = -1;
+			WRITE_ONCE(edma_parser_alias_owner, -1);
 		}
 #endif
 		return ret;
@@ -314,7 +342,7 @@
 		ret = edma_port_parser_alias_program(ppe_port, false);
 		if (ret)
 			netdev_err(netdev, "failed to restore the PPE parser TPIDs: %d\n", ret);
-		edma_parser_alias_owner = -1;
+		WRITE_ONCE(edma_parser_alias_owner, -1);
 	}
 #endif
 
@@ -759,6 +787,7 @@
 	 */
 	in.mac_bitmap = GENMASK(PPE_MY_MAC_TBL_ENTRIES - 1, 0);
 	in.ipv4_uc_route_en = true;
+	in.ipv6_uc_route_en = true;
 	/* Hardware decrements the TTL, so an expired one must come back
 	 * to the CPU (which answers it) rather than being forwarded.
 	 */
diff -ruN a/drivers/net/ethernet/qualcomm/ppe/edma_port.h b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h	2026-10-01 16:58:26.760008427 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h	2026-10-01 16:58:27.320008428 +0000
@@ -93,6 +93,28 @@
  * packet out through this port, and by a flow entry's src_l3_if when
  * the packet arrives on it.
  */
+/**
+ * enum edma_parser_state - What the ingress parser was last programmed
+ * for on a port (struct edma_port_priv::parser_state).
+ * @EDMA_PARSER_UNSET: Never programmed since open.
+ * @EDMA_PARSER_PLAIN: Edge role, no DSA involvement.
+ * @EDMA_PARSER_DSA_8021Q: DSA conduit, reset TPIDs (802.1Q-based tagger).
+ * @EDMA_PARSER_DSA_RTL8_4: DSA conduit, rtl8_4 head tag aliased as QinQ.
+ * @EDMA_PARSER_DENIED: Wanted the alias, another port owns it (logged once).
+ *
+ * Written under RTNL from ndo_open/ndo_stop and the netdevice notifier.
+ * The flow-offload path reads it with READ_ONCE() to pick the egress
+ * encapsulation that matches what the parser, and with it the chip-wide
+ * egress TPIDs, are set to.
+ */
+enum edma_parser_state {
+	EDMA_PARSER_UNSET,
+	EDMA_PARSER_PLAIN,
+	EDMA_PARSER_DSA_8021Q,
+	EDMA_PARSER_DSA_RTL8_4,
+	EDMA_PARSER_DENIED,
+};
+
 struct edma_port_priv {
 	struct ppe_port *ppe_port;
 	struct net_device *netdev;
@@ -106,4 +128,12 @@
 void edma_port_destroy(struct ppe_port *port);
 int edma_port_setup(struct ppe_port *port);
 bool edma_port_is_edma_netdev(const struct net_device *netdev);
+#if IS_ENABLED(CONFIG_NET_DSA)
+bool edma_port_parser_alias_active(void);
+#else
+static inline bool edma_port_parser_alias_active(void)
+{
+	return false;
+}
+#endif
 #endif
diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c	2026-10-01 16:58:26.760008427 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c	2026-10-01 16:58:27.340008428 +0000
@@ -12,6 +12,7 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/device.h>
 #include <linux/mutex.h>
 #include <linux/regmap.h>
 
@@ -72,8 +73,13 @@
 	if (ret)
 		return ret;
 
+	/* A hash-mode add is refused when no way of the key's bucket is free:
+	 * the only refusal seen on the GL-BE9300, and what callers need to
+	 * tell from a fault. Any other refusal stays -EIO.
+	 */
 	if (FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_OP_RSLT, rslt))
-		return -EIO;
+		return op_type == PPE_FLOW_TBL_OP_ADD && mode == PPE_FLOW_OP_MODE_HASH ?
+		       -ENOSPC : -EIO;
 
 	*index = FIELD_GET(PPE_IN_FLOW_TBL_OP_RSLT_ENTRY_INDEX, rslt);
 
@@ -187,7 +193,9 @@
  * ppe_flow_entry_add() - Add (or overwrite) a PPE flow table entry.
  * @ppe_dev: PPE device.
  * @mode: Hash-based or caller-indexed entry placement.
- * @entry: The flow entry to write, as PPE_FLOW_TBL_ENTRY_WORDS 32-bit words.
+ * @entry: The flow entry to write, as @num_words 32-bit words.
+ * @num_words: Number of words in @entry: PPE_FLOW_TBL_IPV4_ENTRY_WORDS or
+ * PPE_FLOW_TBL_IPV6_ENTRY_WORDS.
  * @index: In PPE_FLOW_OP_MODE_INDEX, the entry index to write to (input).
  * On success, always holds the entry's final hardware index: unchanged
  * for PPE_FLOW_OP_MODE_INDEX, hardware-assigned for PPE_FLOW_OP_MODE_HASH.
@@ -195,14 +203,17 @@
  * Return: 0 on success, a negative error code on failure.
  */
 int ppe_flow_entry_add(struct ppe_device *ppe_dev, enum ppe_flow_op_mode mode,
-			const u32 entry[PPE_FLOW_TBL_ENTRY_WORDS], u32 *index)
+			const u32 *entry, unsigned int num_words, u32 *index)
 {
+	unsigned int i;
 	int ret;
-	int i;
+
+	if (num_words > PPE_IN_FLOW_TBL_OP_DATA_ENTRIES)
+		return -EINVAL;
 
 	mutex_lock(&ppe_dev->flow_tbl_lock);
 
-	for (i = 0; i < PPE_FLOW_TBL_ENTRY_WORDS; i++) {
+	for (i = 0; i < num_words; i++) {
 		ret = regmap_write(ppe_dev->regmap,
 				    PPE_IN_FLOW_TBL_OP_DATA_ADDR + i * PPE_IN_FLOW_TBL_OP_DATA_INC,
 				    entry[i]);
@@ -221,6 +232,17 @@
 	 * occupant's lifetime totals to this flow on its first stats poll.
 	 */
 	ret = ppe_flow_counter_clear(ppe_dev, *index);
+	if (ret) {
+		/* The add has landed; callers treat an error as "nothing
+		 * programmed" and release the entries it points at, so take
+		 * it back out rather than leave a live entry nobody tracks.
+		 */
+		if (ppe_flow_tbl_op_wait(ppe_dev, PPE_FLOW_TBL_OP_DEL,
+					 PPE_FLOW_OP_MODE_INDEX, index))
+			dev_warn(ppe_dev->dev,
+				 "flow entry %u left programmed after a counter clear failure\n",
+				 *index);
+	}
 out:
 	mutex_unlock(&ppe_dev->flow_tbl_lock);
 	return ret;
