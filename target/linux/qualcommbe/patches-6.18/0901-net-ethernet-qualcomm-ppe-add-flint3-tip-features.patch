+static bool ppe_offload_ipv6_selftest(struct ppe_device *ppe_dev)
+{
+	struct ppe_flow_ipv6_route_entry probe = {};
+	u32 words[PPE_FLOW_TBL_IPV6_ENTRY_WORDS];
+	u32 index, head, tail;
+	bool ok = false;
+	int ret;
+
+	probe.valid = true;
+	probe.protocol = PPE_FLOW_PROTO_TCP;
+	ppe_flow_ipv6_route_entry_encode(&probe, words);
+
+	ret = ppe_flow_entry_add(ppe_dev, PPE_FLOW_OP_MODE_HASH, words,
+				 PPE_FLOW_TBL_IPV6_ENTRY_WORDS, &index);
+	if (ret) {
+		pr_warn("ppe_offload: ipv6 self-test: probe add failed: %d\n", ret);
+		return false;
+	}
+
+	if (index & 1) {
+		pr_warn("ppe_offload: ipv6 self-test: probe landed at odd index %u\n", index);
+		goto del;
+	}
+
+	if (ppe_offload_flow_slot_word0(ppe_dev, index, &head) ||
+	    ppe_offload_flow_slot_word0(ppe_dev, index + 1, &tail)) {
+		pr_warn("ppe_offload: ipv6 self-test: slot read failed\n");
+		goto del;
+	}
+	if (!(head & PPE_FLOW_TBL_VALID) || (tail & PPE_FLOW_TBL_VALID)) {
+		pr_warn("ppe_offload: ipv6 self-test: after add slot %u word0 %08x, slot %u word0 %08x\n",
+			index, head, index + 1, tail);
+		goto del;
+	}
+	ok = true;
+
+del:
+	ret = ppe_flow_entry_del(ppe_dev, index);
+	if (ret) {
+		pr_warn("ppe_offload: ipv6 self-test: probe delete failed: %d\n", ret);
+		return false;
+	}
+	if (ppe_offload_flow_slot_word0(ppe_dev, index, &head) ||
+	    ppe_offload_flow_slot_word0(ppe_dev, index + 1, &tail))
+		return false;
+	if ((head & PPE_FLOW_TBL_VALID) || (tail & PPE_FLOW_TBL_VALID)) {
+		pr_warn("ppe_offload: ipv6 self-test: after delete slot %u word0 %08x, slot %u word0 %08x\n",
+			index, head, index + 1, tail);
+		return false;
+	}
+
+	if (ok)
+		pr_info("ppe_offload: ipv6 self-test passed at index %u\n", index);
+	return ok;
+}
