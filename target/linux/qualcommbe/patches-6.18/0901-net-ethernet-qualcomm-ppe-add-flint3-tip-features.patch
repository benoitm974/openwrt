+					 const struct net_device *dev)
+{
+	struct rt6_info *rt;
+	bool via;
+
+	rt = rt6_lookup(net, addr, NULL, 0, NULL, 0);
+	if (!rt)
+		return false;
+	via = rt->dst.dev == dev;
+	ip6_rt_put(rt);
+
+	return via;
