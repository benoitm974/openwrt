diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.c b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.c	2026-10-01 16:58:27.330008428 +0000
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. */
+
+/* IPv6 5-tuple flow entry field encoding, ROUTE variant.
+ *
+ * Packs/unpacks struct ppe_flow_ipv6_route_entry to/from the
+ * PPE_FLOW_TBL_IPV6_ENTRY_WORDS-word format ppe_flow_entry_add() takes.
+ * Word 0 and the flag bits of word 1 are the IPv4 entry's; word 1's
+ * low bits carry the ROUTE overlay (nexthop + optional port override)
+ * instead of a NAT overlay's nexthop + port; then, the address being
+ * 128 bits wide, the VPN/PMTU fields follow the service code in word
+ * 2, the L4 ports sit in words 3/4 and the address spans words 4-8.
+ * All confirmed against the vendor SDK's packed bitfield structs
+ * (struct in_flow_ipv6_5tuple_tbl_2, APPE branch, include/hsl/hppe/
+ * hppe_flow_reg.h) and its assignment code (adpt_hppe_flow_entry_host_op_add()
+ * for FAL_FLOW_IP6_5TUPLE_ADDR, src/adpt/hppe/adpt_hppe_flow.c).
+ *
+ * The address is a single big-endian 128-bit integer to the hardware
+ * (the vendor's fal_ip6_addr_t ul[0] is the leading hextets, and its
+ * packing starts from ul[3]), packed least significant bits first
+ * across the split fields; ppe_flow_ipv6_addr_words() turns an
+ * in6_addr into that integer's little-end-first word array.
+ */
+
+#include <asm/byteorder.h>
+#include <linux/bitfield.h>
+#include <linux/in6.h>
+#include <linux/types.h>
+
+#include "ppe_flow.h"
+#include "ppe_flow_ipv4.h"
+#include "ppe_flow_ipv6.h"
+#include "ppe_regs.h"
+
+/* w[0] is the least significant 32 bits of the address as an integer
+ * (its last four bytes), w[3] the most significant (its first four).
+ */
+static void ppe_flow_ipv6_addr_words(const struct in6_addr *addr, u32 w[4])
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		w[i] = be32_to_cpu(addr->s6_addr32[3 - i]);
+}
+
+static void ppe_flow_ipv6_addr_from_words(const u32 w[4], struct in6_addr *addr)
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		addr->s6_addr32[3 - i] = cpu_to_be32(w[i]);
+}
+
+/**
+ * ppe_flow_ipv6_route_entry_encode() - Pack an IPv6 ROUTE flow entry.
+ * @entry: The entry to pack.
+ * @words: Where to write the packed PPE_FLOW_TBL_IPV6_ENTRY_WORDS words.
+ */
+void ppe_flow_ipv6_route_entry_encode(const struct ppe_flow_ipv6_route_entry *entry,
+				      u32 words[PPE_FLOW_TBL_IPV6_ENTRY_WORDS])
+{
+	u32 ip[4];
+
+	ppe_flow_ipv6_addr_words(&entry->match_ip, ip);
+
+	words[0] = entry->valid ? PPE_FLOW_TBL_VALID : 0;
+	words[0] |= PPE_FLOW_TBL_ENTRY_TYPE;	/* IPv6 */
+	words[0] |= entry->host_addr_is_dst ? PPE_FLOW_TBL_HOST_ADDR_INDEX_TYPE : 0;
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_HOST_ADDR_INDEX, entry->host_addr_index);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_PROTOCOL_TYPE, entry->protocol);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_AGE, entry->age);
+	words[0] |= entry->src_l3_if_valid ? PPE_FLOW_TBL_SRC_L3_IF_VALID : 0;
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_SRC_L3_IF, entry->src_l3_if);
+	words[0] |= FIELD_PREP(PPE_FLOW_TBL_FWD_TYPE, PPE_FLOW_FWD_ROUTE);
+
+	words[1] = FIELD_PREP(PPE_FLOW_TBL_ROUTE_NEXT_HOP, entry->route_nexthop);
+	/* PORT_VP_VALID clear: the nexthop's port is the egress. */
+	words[1] |= entry->deacclr_en ? PPE_FLOW_TBL_DE_ACCE : 0;
+	words[1] |= entry->copy_to_cpu ? PPE_FLOW_TBL_COPY_TO_CPU_EN : 0;
+	words[1] |= entry->syn_toggle ? PPE_FLOW_TBL_SYN_TOGGLE : 0;
+	words[1] |= FIELD_PREP(PPE_FLOW_TBL_PRI_PROFILE_0, entry->pri_profile & 0x1);
+
+	words[2] = FIELD_PREP(PPE_FLOW_TBL_PRI_PROFILE_1, entry->pri_profile >> 1);
+	words[2] |= FIELD_PREP(PPE_FLOW_TBL_SERVICE_CODE, entry->service_code);
+	words[2] |= entry->pmtu_check_l3 ? PPE_FLOW_TBL_IPV6_PMTU_CHECK_TYPE : 0;
+	words[2] |= FIELD_PREP(PPE_FLOW_TBL_IPV6_PMTU_0, entry->pmtu);
+
+	words[3] = FIELD_PREP(PPE_FLOW_TBL_IPV6_PMTU_1, entry->pmtu >> 11);
+	words[3] |= FIELD_PREP(PPE_FLOW_TBL_IPV6_L4_SPORT, entry->match_sport);
+	words[3] |= FIELD_PREP(PPE_FLOW_TBL_IPV6_L4_DPORT_0, entry->match_dport);
+
+	words[4] = FIELD_PREP(PPE_FLOW_TBL_IPV6_L4_DPORT_1, entry->match_dport >> 4);
+	words[4] |= FIELD_PREP(PPE_FLOW_TBL_IPV6_IP_ADDR_0, ip[0]);
+	words[5] = ip[0] >> 20 | ip[1] << 12;
+	words[6] = ip[1] >> 20 | ip[2] << 12;
+	words[7] = ip[2] >> 20 | ip[3] << 12;
+	words[8] = FIELD_PREP(PPE_FLOW_TBL_IPV6_IP_ADDR_4, ip[3] >> 20);
+}
+
+/**
+ * ppe_flow_ipv6_route_entry_decode() - Unpack an IPv6 ROUTE flow entry.
+ * @words: The packed PPE_FLOW_TBL_IPV6_ENTRY_WORDS words to unpack.
+ * @entry: Where to store the unpacked entry.
+ *
+ * Does not validate ENTRY_TYPE or FWD_TYPE: callers are expected to only
+ * decode entries they know use this layout (e.g. ones they wrote).
+ */
+void ppe_flow_ipv6_route_entry_decode(const u32 words[PPE_FLOW_TBL_IPV6_ENTRY_WORDS],
+				      struct ppe_flow_ipv6_route_entry *entry)
+{
+	u32 ip[4];
+
+	entry->valid = !!(words[0] & PPE_FLOW_TBL_VALID);
+	entry->host_addr_is_dst = !!(words[0] & PPE_FLOW_TBL_HOST_ADDR_INDEX_TYPE);
+	entry->host_addr_index = FIELD_GET(PPE_FLOW_TBL_HOST_ADDR_INDEX, words[0]);
+	entry->protocol = FIELD_GET(PPE_FLOW_TBL_PROTOCOL_TYPE, words[0]);
+	entry->age = FIELD_GET(PPE_FLOW_TBL_AGE, words[0]);
+	entry->src_l3_if_valid = !!(words[0] & PPE_FLOW_TBL_SRC_L3_IF_VALID);
+	entry->src_l3_if = FIELD_GET(PPE_FLOW_TBL_SRC_L3_IF, words[0]);
+
+	entry->route_nexthop = FIELD_GET(PPE_FLOW_TBL_ROUTE_NEXT_HOP, words[1]);
+	entry->deacclr_en = !!(words[1] & PPE_FLOW_TBL_DE_ACCE);
+	entry->copy_to_cpu = !!(words[1] & PPE_FLOW_TBL_COPY_TO_CPU_EN);
+	entry->syn_toggle = !!(words[1] & PPE_FLOW_TBL_SYN_TOGGLE);
+
+	entry->pri_profile = FIELD_GET(PPE_FLOW_TBL_PRI_PROFILE_0, words[1]) |
+			      (FIELD_GET(PPE_FLOW_TBL_PRI_PROFILE_1, words[2]) << 1);
+	entry->service_code = FIELD_GET(PPE_FLOW_TBL_SERVICE_CODE, words[2]);
+	entry->pmtu_check_l3 = !!(words[2] & PPE_FLOW_TBL_IPV6_PMTU_CHECK_TYPE);
+	entry->pmtu = FIELD_GET(PPE_FLOW_TBL_IPV6_PMTU_0, words[2]) |
+		      (FIELD_GET(PPE_FLOW_TBL_IPV6_PMTU_1, words[3]) << 11);
+
+	entry->match_sport = FIELD_GET(PPE_FLOW_TBL_IPV6_L4_SPORT, words[3]);
+	entry->match_dport = FIELD_GET(PPE_FLOW_TBL_IPV6_L4_DPORT_0, words[3]) |
+			      (FIELD_GET(PPE_FLOW_TBL_IPV6_L4_DPORT_1, words[4]) << 4);
+
+	ip[0] = FIELD_GET(PPE_FLOW_TBL_IPV6_IP_ADDR_0, words[4]) | words[5] << 20;
+	ip[1] = words[5] >> 12 | words[6] << 20;
+	ip[2] = words[6] >> 12 | words[7] << 20;
+	ip[3] = words[7] >> 12 | FIELD_GET(PPE_FLOW_TBL_IPV6_IP_ADDR_4, words[8]) << 20;
+	ppe_flow_ipv6_addr_from_words(ip, &entry->match_ip);
+}
diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.h b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.h
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_ipv6.h	2026-10-01 16:58:27.330008428 +0000
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __PPE_FLOW_IPV6_H__
+#define __PPE_FLOW_IPV6_H__
+
+#include <linux/in6.h>
+#include <linux/types.h>
+
+#include "ppe_flow.h"
+#include "ppe_flow_ipv4.h"
+
+/**
+ * struct ppe_flow_ipv6_route_entry - IPv6 5-tuple flow entry, ROUTE variant.
+ * @valid: Whether this entry is active.
+ * @host_addr_is_dst: @host_addr_index refers to the destination address's
+ * host table entry when true, the source's when false. The endpoint this
+ * does *not* refer to is @match_ip below.
+ * @host_addr_index: Host table index (see ppe_host.h) of an IPv6 host
+ * entry, for the endpoint selected by @host_addr_is_dst.
+ * @protocol: Layer-4 protocol to match.
+ * @age: Hardware aging counter; write 0 on entry creation.
+ * @src_l3_if_valid: Whether @src_l3_if should be matched.
+ * @src_l3_if: Source L3 interface index to match, when @src_l3_if_valid.
+ * @route_nexthop: Nexthop table index (see ppe_nexthop.h) matched packets
+ * egress through, rewritten to its MAC and tags, with nothing above L2
+ * changed but the hop limit. The forward type is fixed at
+ * PPE_FLOW_FWD_ROUTE and the entry's port override is left unset, so the
+ * nexthop's port is the egress, as for the NAT entries.
+ * @deacclr_en: See struct ppe_flow_ipv4_nat_entry.
+ * @copy_to_cpu: Whether to also copy matched packets to the CPU path.
+ * @syn_toggle: Updated by hardware; not meaningful to set on creation.
+ * @pri_profile: QoS priority profile index for this flow.
+ * @service_code: Service code applied to matched packets.
+ * @match_ip: The 5-tuple match address for the endpoint not covered by
+ * @host_addr_index.
+ * @match_sport: Source port to match.
+ * @match_dport: Destination port to match.
+ * @pmtu: Path MTU matched packets are checked against before being
+ * forwarded; a packet exceeding it is redirected to the CPU. Must be
+ * set -- 0 would fail every packet.
+ * @pmtu_check_l3: Compare @pmtu against the L3 packet length (true) or
+ * the length including the L2 header (false).
+ */
+struct ppe_flow_ipv6_route_entry {
+	bool valid;
+	bool host_addr_is_dst;
+	u16 host_addr_index;
+	enum ppe_flow_protocol protocol;
+	u8 age;
+	bool src_l3_if_valid;
+	u8 src_l3_if;
+	u16 route_nexthop;
+	bool deacclr_en;
+	bool copy_to_cpu;
+	u8 syn_toggle;
+	u8 pri_profile;
+	u8 service_code;
+	struct in6_addr match_ip;
+	u16 match_sport;
+	u16 match_dport;
+	u16 pmtu;
+	bool pmtu_check_l3;
+};
+
+void ppe_flow_ipv6_route_entry_encode(const struct ppe_flow_ipv6_route_entry *entry,
+				      u32 words[PPE_FLOW_TBL_IPV6_ENTRY_WORDS]);
+void ppe_flow_ipv6_route_entry_decode(const u32 words[PPE_FLOW_TBL_IPV6_ENTRY_WORDS],
+				      struct ppe_flow_ipv6_route_entry *entry);
+
+#endif
diff -ruN a/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv6.c b/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv6.c
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv6.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_host_ipv6.c	2026-10-01 16:58:27.330008428 +0000
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. */
+
+/* IPv6 host table entry field encoding.
+ *
+ * As ppe_host_ipv4.c, with key_type selecting the plain-IPv6 variant
+ * (vendor adpt_hppe_ip_host_add(): key_type=2) and the 128-bit address
+ * packed as one big-endian integer, least significant bits first, from
+ * bit 22 of word 0 through words 1-3 into the low 22 bits of word 4 --
+ * the vendor SDK's struct host_ipv6_tbl and its assignment code, which
+ * starts the packing from fal_ip6_addr_t's ul[3] (the last hextets).
+ */
+
+#include <asm/byteorder.h>
+#include <linux/bitfield.h>
+#include <linux/in6.h>
+#include <linux/types.h>
+
+#include "ppe_host.h"
+#include "ppe_host_ipv6.h"
+#include "ppe_regs.h"
+
+/**
+ * ppe_host_ipv6_entry_encode() - Pack an IPv6 host table entry.
+ * @entry: The entry to pack.
+ * @words: Where to write the packed PPE_HOST_TBL_IPV6_ENTRY_WORDS words.
+ */
+void ppe_host_ipv6_entry_encode(const struct ppe_host_ipv6_entry *entry,
+				u32 words[PPE_HOST_TBL_IPV6_ENTRY_WORDS])
+{
+	u32 ip[4];
+	int i;
+
+	/* ip[0] is the address's last four bytes as an integer, ip[3] its first. */
+	for (i = 0; i < 4; i++)
+		ip[i] = be32_to_cpu(entry->ip_addr.s6_addr32[3 - i]);
+
+	words[0] = entry->valid ? PPE_HOST_TBL_VALID : 0;
+	words[0] |= FIELD_PREP(PPE_HOST_TBL_KEY_TYPE, PPE_HOST_TBL_KEY_TYPE_IPV6);
+	words[0] |= entry->wan ? PPE_HOST_TBL_LAN_WAN : 0;
+	words[0] |= FIELD_PREP(PPE_HOST_TBL_IPV6_ADDR_0, ip[0]);
+	words[1] = ip[0] >> 10 | ip[1] << 22;
+	words[2] = ip[1] >> 10 | ip[2] << 22;
+	words[3] = ip[2] >> 10 | ip[3] << 22;
+	words[4] = FIELD_PREP(PPE_HOST_TBL_IPV6_ADDR_4, ip[3] >> 10);
+}
+
+/**
+ * ppe_host_ipv6_entry_decode() - Unpack an IPv6 host table entry.
+ * @words: The packed PPE_HOST_TBL_IPV6_ENTRY_WORDS words to unpack.
+ * @entry: Where to store the unpacked entry.
+ */
+void ppe_host_ipv6_entry_decode(const u32 words[PPE_HOST_TBL_IPV6_ENTRY_WORDS],
+				struct ppe_host_ipv6_entry *entry)
+{
+	u32 ip[4];
+	int i;
+
+	entry->valid = !!(words[0] & PPE_HOST_TBL_VALID);
+	entry->wan = !!(words[0] & PPE_HOST_TBL_LAN_WAN);
+
+	ip[0] = FIELD_GET(PPE_HOST_TBL_IPV6_ADDR_0, words[0]) | words[1] << 10;
+	ip[1] = words[1] >> 22 | words[2] << 10;
+	ip[2] = words[2] >> 22 | words[3] << 10;
+	ip[3] = words[3] >> 22 | FIELD_GET(PPE_HOST_TBL_IPV6_ADDR_4, words[4]) << 10;
+
+	for (i = 0; i < 4; i++)
+		entry->ip_addr.s6_addr32[3 - i] = cpu_to_be32(ip[i]);
+}
