--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h	2026-10-01 16:58:26.770008427 +0000
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h	2026-10-01 16:58:27.330008428 +0000
@@ -10,15 +10,28 @@
 
 #include "ppe.h"
 
-/* Number of 32-bit words that make up one IPv4 5-tuple flow entry.
- * This is the entry's own size (union in_flow_tbl_u's val[6] in the
- * vendor SDK for this APPE chip, see ppe_regs.h), not the wider 11-word
- * capacity of PPE_IN_FLOW_TBL_OP_DATA -- that register block is sized
- * for the largest entry type sharing this trigger mechanism (an IPv6
- * 5-tuple entry needs more words for its wider addresses). Word 5 holds
- * the top bits of the path MTU the hardware checks each packet against.
+/* Number of 32-bit words that make up one flow entry of each family.
+ * These are the entries' own sizes (the vendor SDK's union in_flow_tbl_u
+ * val[6] and union in_flow_ipv6_5tuple_tbl_u val[9] for this APPE chip,
+ * see ppe_regs.h), not the wider 11-word capacity of
+ * PPE_IN_FLOW_TBL_OP_DATA, which is sized for the largest entry type
+ * sharing this trigger mechanism. Word 5 of the IPv4 entry and word 3
+ * of the IPv6 one hold the top bits of the path MTU the hardware checks
+ * each packet against.
  */
-#define PPE_FLOW_TBL_ENTRY_WORDS		6
+#define PPE_FLOW_TBL_IPV4_ENTRY_WORDS		6
+#define PPE_FLOW_TBL_IPV6_ENTRY_WORDS		9
+#define PPE_FLOW_TBL_MAX_ENTRY_WORDS		PPE_FLOW_TBL_IPV6_ENTRY_WORDS
+
+/* The table is laid out in IPv4-sized slots (PPE_IN_FLOW_TBL_ENTRIES of
+ * them); an IPv6 entry is twice the size and takes two consecutive ones.
+ * The vendor SDK addresses the per-slot hit counters with the very index
+ * an IPv6 add returns, so the index is taken to be in slot units for
+ * both families (even for IPv6) -- an assumption the offload code checks
+ * on every IPv6 add, declining the flow if it does not hold.
+ */
+#define PPE_FLOW_TBL_IPV4_ENTRY_SLOTS		1
+#define PPE_FLOW_TBL_IPV6_ENTRY_SLOTS		2
 
 /**
  * enum ppe_flow_op_mode - PPE flow table addressing mode.
@@ -36,7 +49,7 @@
 			 u64 *packets, u64 *bytes);
 int ppe_flow_counter_clear(struct ppe_device *ppe_dev, u32 index);
 int ppe_flow_entry_add(struct ppe_device *ppe_dev, enum ppe_flow_op_mode mode,
-			const u32 entry[PPE_FLOW_TBL_ENTRY_WORDS], u32 *index);
+			const u32 *entry, unsigned int num_words, u32 *index);
 int ppe_flow_entry_del(struct ppe_device *ppe_dev, u32 index);
 
 #endif
