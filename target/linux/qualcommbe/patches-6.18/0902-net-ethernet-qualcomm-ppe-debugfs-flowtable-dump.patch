From: Benoit Masson <yahoo@perenite.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: debugfs flow-table dump (local debug)

Temporary local-debug patch, not for upstream: dumps every valid flow
table slot (IPv4 5-word and IPv6 9/2-slot entries) with the key words,
so live entries can be compared against arriving packets when a lookup
misses. Read at /sys/kernel/debug/ppe/flowtable.

Signed-off-by: Benoit Masson <yahoo@perenite.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_debugfs.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_debugfs.c
@@ -823,6 +823,60 @@ static int ppe_port_mib_show(struct seq_file *seq, void *v)
 }
 PPE_DEBUGFS_ATTR(ppe_port_mib);
 
+static int ppe_flowtable_show(struct seq_file *seq, void *v)
+{
+	struct ppe_device *ppe_dev = seq->private;
+	u32 w[9];
+	int ret;
+	u32 idx;
+	int words;
+	int i;
+
+	for (idx = 0; idx < 4096; idx++) {
+		ret = regmap_bulk_read(ppe_dev->regmap,
+				       0x240000 + idx * 0x20, w, 1);
+		if (ret)
+			return ret;
+		if (!(w[0] & BIT(31)))
+			continue;
+		/* word0 bit ? = entry type: 1 = IPv6 (9 words, 2 slots) */
+		words = (w[0] & BIT(29)) ? 9 : 5;
+		ret = regmap_bulk_read(ppe_dev->regmap,
+				       0x240000 + idx * 0x20, w, words);
+		if (ret)
+			return ret;
+		seq_printf(seq, "idx %u w0 %08x", idx, w[0]);
+		for (i = 1; i < words; i++)
+			seq_printf(seq, " w%d %08x", i, w[i]);
+		seq_puts(seq, "\n");
+		if (words == 9)
+			idx++; /* two slots per IPv6 entry */
+	}
+	return 0;
+}
+PPE_DEBUGFS_ATTR(ppe_flowtable);
+
 static struct ppe_debugfs_file debugfs_files[] = {
+	{ "flowtable", &ppe_flowtable_attr },
 	{ "bm", &ppe_bm_attr },
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
@@ -1128,6 +1128,9 @@
  */
 #define PPE_IN_FLOW_TBL_ENTRIES			4096
 
+/* Absolute offset of the flow table inside the PPE regmap window:
+ * IPE_L3_BASE_ADDR (0x200000) + IN_FLOW_TBL_ADDRESS (0x40000).
+ */
+#define PPE_IN_FLOW_TBL_ABS			0x240000
 
 /* Per-flow hit counters, indexed by the flow table entry index.
